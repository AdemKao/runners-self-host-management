#!/usr/bin/env bash
set -euo pipefail

RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
RUNNERS_DIR="$RUNNERCTL_HOME/runners"
NOTIFY_DIR="$RUNNERCTL_HOME/notify"
RUNNER_CONFIG_DIR="$NOTIFY_DIR/runners"
HOOK_TARGET_DIR="$NOTIFY_DIR/hooks"
PLUGIN_DIR="$RUNNERCTL_HOME/plugins/notify"
LOG_FILE="$NOTIFY_DIR/notify.log"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

info(){ printf '[runnerctl-notify] %s\n' "$*"; }
warn(){ printf '[runnerctl-notify] WARN: %s\n' "$*" >&2; }
die(){ printf '[runnerctl-notify] ERROR: %s\n' "$*" >&2; exit 1; }

usage(){ cat <<'EOF'
Notification integrations and provider plugins.

Usage:
  runnerctl notify status [--json]
  runnerctl notify providers [--json]
  runnerctl notify test [--provider NAME|--all]
  runnerctl notify emit EVENT [--message TEXT] [--runner NAME]
  runnerctl notify enable RUNNER [--events LIST]
  runnerctl notify disable RUNNER

Built-in providers:
  telegram   Telegram Bot API sendMessage
  line       LINE Messaging API push message
  webhook    Generic HTTP JSON webhook

Custom providers:
  Place an executable in:
    $RUNNERCTL_HOME/plugins/notify/NAME

Provider contract:
  - event JSON is provided on stdin
  - RUNNERCTL_NOTIFY_EVENT contains the event name
  - RUNNERCTL_NOTIFY_MESSAGE contains the rendered text message
  - exit 0 on delivery success; non-zero on failure

Secrets are read from environment variables and are never printed by status:
  RUNNERCTL_TELEGRAM_BOT_TOKEN
  RUNNERCTL_TELEGRAM_CHAT_ID
  RUNNERCTL_LINE_CHANNEL_ACCESS_TOKEN
  RUNNERCTL_LINE_TO
  RUNNERCTL_WEBHOOK_URL
  RUNNERCTL_WEBHOOK_AUTH_HEADER   optional complete HTTP header value

Optional provider selection:
  RUNNERCTL_NOTIFY_PROVIDERS=telegram,line,webhook,custom-name

Job hook delivery is fail-open and uses short provider network timeouts.
Manual `notify test` and `notify emit` return non-zero when delivery fails.
EOF
}

ensure_dirs(){ mkdir -p "$NOTIFY_DIR" "$RUNNER_CONFIG_DIR" "$HOOK_TARGET_DIR" "$PLUGIN_DIR"; chmod 0700 "$NOTIFY_DIR" "$RUNNER_CONFIG_DIR" "$HOOK_TARGET_DIR" "$PLUGIN_DIR" 2>/dev/null || true; }
json_quote(){ local v="${1:-}"; v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; v="${v//$'\n'/\\n}"; v="${v//$'\r'/\\r}"; v="${v//$'\t'/\\t}"; printf '"%s"' "$v"; }
now_utc(){ date -u '+%Y-%m-%dT%H:%M:%SZ'; }
host_name(){ hostname 2>/dev/null || printf unknown; }

find_hooks_helper(){
  local candidates=("${RUNNERCTL_HOOKS_HELPER:-}" "$SCRIPT_DIR/runnerctl-hooks" "$SCRIPT_DIR/../libexec/runnerctl-hooks" "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-hooks") c
  for c in "${candidates[@]}"; do [[ -n "$c" && -f "$c" ]] || continue; printf '%s' "$c"; return; done
  die "runnerctl-hooks helper not found; reinstall runnerctl"
}
provider_path(){
  local name="$1" c
  case "$name" in
    telegram|line|webhook)
      for c in "$SCRIPT_DIR/runnerctl-notify-provider-$name" "$SCRIPT_DIR/../libexec/runnerctl-notify-provider-$name" "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-notify-provider-$name"; do
        [[ -f "$c" ]] || continue; printf '%s' "$c"; return 0
      done
      ;;
  esac
  c="$PLUGIN_DIR/$name"
  [[ -x "$c" ]] && { printf '%s' "$c"; return 0; }
  return 1
}
provider_configured(){
  case "$1" in
    telegram) [[ -n "${RUNNERCTL_TELEGRAM_BOT_TOKEN:-}" && -n "${RUNNERCTL_TELEGRAM_CHAT_ID:-}" ]] ;;
    line) [[ -n "${RUNNERCTL_LINE_CHANNEL_ACCESS_TOKEN:-}" && -n "${RUNNERCTL_LINE_TO:-}" ]] ;;
    webhook) [[ -n "${RUNNERCTL_WEBHOOK_URL:-}" ]] ;;
    *) [[ -x "$PLUGIN_DIR/$1" ]] ;;
  esac
}
provider_names(){
  local explicit="${RUNNERCTL_NOTIFY_PROVIDERS:-}" p f
  if [[ -n "$explicit" ]]; then
    printf '%s' "$explicit" | tr ',' '\n' | awk 'NF && !seen[$0]++'
    return
  fi
  for p in telegram line webhook; do provider_configured "$p" && printf '%s\n' "$p"; done
  shopt -s nullglob
  for f in "$PLUGIN_DIR"/*; do [[ -x "$f" ]] && printf '%s\n' "$(basename "$f")"; done
}

runner_meta(){ local runner="$1" key="$2"; awk -F= -v k="$key" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$RUNNERS_DIR/$runner/.runnerctl-meta" 2>/dev/null || true; }
runner_cfg(){ printf '%s/%s.conf' "$RUNNER_CONFIG_DIR" "$1"; }
runner_enabled(){ local f; f="$(runner_cfg "$1")"; [[ -f "$f" ]] && [[ "$(awk -F= '$1=="enabled"{print $2;exit}' "$f" 2>/dev/null || true)" == true ]]; }
runner_events(){ local f v; f="$(runner_cfg "$1")"; v="$(awk -F= '$1=="events"{sub(/^[^=]*=/,"");print;exit}' "$f" 2>/dev/null || true)"; printf '%s' "${v:-job.started,job.completed}"; }
event_allowed(){ local runner="$1" event="$2" events; runner_enabled "$runner" || return 1; events=",$(runner_events "$runner"),"; [[ "$events" == *",$event,"* || "$events" == *",*,"* ]]; }

build_event(){
  local event="$1" runner="$2" message="$3" repo run_id run_attempt job workflow server run_url ts host
  repo="${GITHUB_REPOSITORY:-}"; [[ -n "$repo" ]] || repo="$(runner_meta "$runner" repo)"
  run_id="${GITHUB_RUN_ID:-}"; run_attempt="${GITHUB_RUN_ATTEMPT:-}"; job="${GITHUB_JOB:-}"; workflow="${GITHUB_WORKFLOW:-}"; server="${GITHUB_SERVER_URL:-https://github.com}"
  run_url=""; [[ -n "$repo" && -n "$run_id" ]] && run_url="$server/$repo/actions/runs/$run_id"
  ts="$(now_utc)"; host="$(host_name)"
  printf '{"schema_version":1,"event":'; json_quote "$event"
  printf ',"timestamp":'; json_quote "$ts"
  printf ',"host":'; json_quote "$host"
  printf ',"runner":'; json_quote "$runner"
  printf ',"repository":'; json_quote "$repo"
  printf ',"run_id":'; json_quote "$run_id"
  printf ',"run_attempt":'; json_quote "$run_attempt"
  printf ',"job":'; json_quote "$job"
  printf ',"workflow":'; json_quote "$workflow"
  printf ',"run_url":'; json_quote "$run_url"
  printf ',"message":'; json_quote "$message"
  printf '}\n'
}
render_message(){
  local event="$1" runner="$2" custom="$3" repo run_id job workflow
  [[ -n "$custom" ]] && { printf '%s' "$custom"; return; }
  repo="${GITHUB_REPOSITORY:-}"; [[ -n "$repo" ]] || repo="$(runner_meta "$runner" repo)"
  run_id="${GITHUB_RUN_ID:-}"; job="${GITHUB_JOB:-}"; workflow="${GITHUB_WORKFLOW:-}"
  printf '[runnerctl] %s' "$event"
  [[ -z "$runner" ]] || printf '\nrunner: %s' "$runner"
  [[ -z "$repo" ]] || printf '\nrepo: %s' "$repo"
  [[ -z "$workflow" ]] || printf '\nworkflow: %s' "$workflow"
  [[ -z "$job" ]] || printf '\njob: %s' "$job"
  [[ -z "$run_id" ]] || printf '\nrun: %s' "$run_id"
}

log_failure(){ ensure_dirs; printf '%s provider=%s event=%s delivery=failed\n' "$(now_utc)" "$1" "$2" >>"$LOG_FILE" 2>/dev/null || true; chmod 0600 "$LOG_FILE" 2>/dev/null || true; }
run_provider_once(){
  local provider="$1" event="$2" message="$3" payload_file="$4" path
  path="$(provider_path "$provider")" || { warn "provider not found: $provider"; return 1; }
  case "$provider" in
    telegram|line|webhook)
      RUNNERCTL_NOTIFY_EVENT="$event" RUNNERCTL_NOTIFY_MESSAGE="$message" RUNNERCTL_NOTIFY_HOOK="${RUNNERCTL_NOTIFY_HOOK:-0}" bash "$path" <"$payload_file"
      ;;
    *)
      RUNNERCTL_NOTIFY_EVENT="$event" RUNNERCTL_NOTIFY_MESSAGE="$message" RUNNERCTL_NOTIFY_HOOK="${RUNNERCTL_NOTIFY_HOOK:-0}" "$path" <"$payload_file"
      ;;
  esac
}
run_provider(){
  local provider="$1" event="$2" message="$3" payload_file="$4" attempts=2 i
  [[ "${RUNNERCTL_NOTIFY_HOOK:-0}" == 1 ]] && attempts=1
  for ((i=1;i<=attempts;i++)); do
    if run_provider_once "$provider" "$event" "$message" "$payload_file"; then return 0; fi
    (( i < attempts )) && sleep 1
  done
  log_failure "$provider" "$event"
  return 1
}
dispatch_event(){
  local event="$1" runner="$2" custom="$3" provider_filter="${4:-}" message payload_file provider any=0 failures=0 rc=0
  ensure_dirs
  message="$(render_message "$event" "$runner" "$custom")"
  payload_file="$(mktemp "$NOTIFY_DIR/event.XXXXXX")"
  build_event "$event" "$runner" "$message" >"$payload_file"; chmod 0600 "$payload_file"
  while IFS= read -r provider; do
    [[ -n "$provider" ]] || continue
    [[ -z "$provider_filter" || "$provider_filter" == "$provider" ]] || continue
    any=1
    if ! provider_configured "$provider"; then warn "provider $provider is not configured"; failures=$((failures+1)); continue; fi
    run_provider "$provider" "$event" "$message" "$payload_file" || failures=$((failures+1))
  done < <(provider_names)
  if [[ "$any" -eq 0 ]]; then warn "no configured notification providers selected"; rc=1
  elif [[ "$failures" -ne 0 ]]; then rc=1
  fi
  rm -f "$payload_file"
  return "$rc"
}

restart_runner(){
  local d="$1"
  [[ "${RUNNERCTL_SKIP_SERVICE_RESTART:-0}" == 1 ]] && return 0
  [[ -x "$d/svc.sh" && -f "$d/.service" ]] || { warn "runner $(basename "$d") needs a manual restart for hook changes"; return 0; }
  if [[ "$(uname -s)" == Linux ]]; then
    (cd "$d" && sudo ./svc.sh stop >/dev/null 2>&1 || true); (cd "$d" && sudo ./svc.sh start >/dev/null)
  else
    (cd "$d" && ./svc.sh stop >/dev/null 2>&1 || true); (cd "$d" && ./svc.sh start >/dev/null)
  fi
}
write_hook_target(){
  local runner="$1" phase="$2" target self
  target="$HOOK_TARGET_DIR/$runner-$phase.sh"
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  mkdir -p "$HOOK_TARGET_DIR"
  cat >"$target" <<EOF
#!/usr/bin/env bash
set +e
RUNNERCTL_HOME="$RUNNERCTL_HOME" RUNNERCTL_NOTIFY_HOOK=1 bash "$self" hook "$runner" "$phase" >/dev/null 2>>"$LOG_FILE"
exit 0
EOF
  chmod 0755 "$target"; printf '%s' "$target"
}
cmd_enable(){
  local runner="${1:-}" events="job.started,job.completed" hooks started completed d
  [[ -n "$runner" ]] || die "notify enable requires RUNNER"; shift || true
  [[ -f "$RUNNERS_DIR/$runner/.runnerctl-meta" ]] || die "Unknown runner: $runner"
  while [[ $# -gt 0 ]]; do case "$1" in --events) events="${2:-}"; shift 2 ;; *) die "unknown notify enable option: $1" ;; esac; done
  [[ "$events" =~ ^[A-Za-z0-9.*_-]+(,[A-Za-z0-9.*_-]+)*$ ]] || die "--events must be a comma-separated event list"
  ensure_dirs; printf 'enabled=true\nevents=%s\n' "$events" >"$(runner_cfg "$runner")"; chmod 0600 "$(runner_cfg "$runner")"
  hooks="$(find_hooks_helper)"; started="$(write_hook_target "$runner" started)"; completed="$(write_hook_target "$runner" completed)"
  RUNNERCTL_HOME="$RUNNERCTL_HOME" bash "$hooks" register "$runner" started notify "$started" >/dev/null
  RUNNERCTL_HOME="$RUNNERCTL_HOME" bash "$hooks" register "$runner" completed notify "$completed" >/dev/null
  d="$RUNNERS_DIR/$runner"; restart_runner "$d"; info "notifications enabled for $runner (events=$events)"
}
cmd_disable(){
  local runner="${1:-}" hooks d
  [[ -n "$runner" && $# -eq 1 ]] || die "notify disable requires RUNNER"
  hooks="$(find_hooks_helper)"; RUNNERCTL_HOME="$RUNNERCTL_HOME" bash "$hooks" unregister "$runner" started notify >/dev/null 2>&1 || true; RUNNERCTL_HOME="$RUNNERCTL_HOME" bash "$hooks" unregister "$runner" completed notify >/dev/null 2>&1 || true
  rm -f "$(runner_cfg "$runner")" "$HOOK_TARGET_DIR/$runner-started.sh" "$HOOK_TARGET_DIR/$runner-completed.sh"
  d="$RUNNERS_DIR/$runner"; [[ -d "$d" ]] && restart_runner "$d"; info "notifications disabled for $runner"
}
cmd_hook(){
  local runner="${1:-}" phase="${2:-}" event
  [[ -n "$runner" && ( "$phase" == started || "$phase" == completed ) ]] || exit 0
  event="job.$phase"; event_allowed "$runner" "$event" || exit 0
  if ! dispatch_event "$event" "$runner" "" ""; then warn "job notification delivery failed (fail-open)"; fi
  exit 0
}

providers_json(){
  local first=true p path configured=false
  printf '['
  for p in telegram line webhook; do
    [[ "$first" == true ]] || printf ','; first=false; provider_configured "$p" && configured=true || configured=false
    printf '{"name":'; json_quote "$p"; printf ',"builtin":true,"configured":%s}' "$configured"
  done
  shopt -s nullglob
  for path in "$PLUGIN_DIR"/*; do [[ -x "$path" ]] || continue; p="$(basename "$path")"; [[ "$first" == true ]] || printf ','; first=false; printf '{"name":'; json_quote "$p"; printf ',"builtin":false,"configured":true}' ; done
  printf ']'
}
cmd_providers(){ local json=0 p; [[ "${1:-}" == --json ]] && { json=1; shift; }; [[ $# -eq 0 ]] || die "providers accepts only --json"; ensure_dirs; if [[ "$json" -eq 1 ]]; then providers_json; printf '\n'; return; fi; printf 'Notification providers\n'; for p in telegram line webhook; do printf '  %-12s builtin  configured=%s\n' "$p" "$(provider_configured "$p" && printf yes || printf no)"; done; shopt -s nullglob; for p in "$PLUGIN_DIR"/*; do [[ -x "$p" ]] && printf '  %-12s plugin   configured=yes\n' "$(basename "$p")"; done; }
cmd_status(){
  local json=0 configured=0 enabled=0 d runner events
  [[ "${1:-}" == --json ]] && { json=1; shift; }; [[ $# -eq 0 ]] || die "status accepts only --json"; ensure_dirs
  shopt -s nullglob; for d in "$RUNNER_CONFIG_DIR"/*.conf; do configured=$((configured+1)); [[ "$(awk -F= '$1=="enabled"{print $2;exit}' "$d")" == true ]] && enabled=$((enabled+1)); done
  if [[ "$json" -eq 1 ]]; then printf '{"configured_runners":%s,"enabled_runners":%s,"providers":' "$configured" "$enabled"; providers_json; printf ',"runners":['; local first=true; for d in "$RUNNER_CONFIG_DIR"/*.conf; do runner="$(basename "$d" .conf)"; events="$(runner_events "$runner")"; [[ "$first" == true ]] || printf ','; first=false; printf '{"runner":'; json_quote "$runner"; printf ',"enabled":%s,"events":' "$(runner_enabled "$runner" && printf true || printf false)"; json_quote "$events"; printf '}'; done; printf ']}\n'; else printf 'Notifications\n  configured runners: %s\n  enabled runners:    %s\n' "$configured" "$enabled"; cmd_providers; fi
}
cmd_test(){
  local provider=""; case "${1:-}" in --provider) provider="${2:-}"; shift 2 ;; --all|"") [[ "${1:-}" == --all ]] && shift ;; *) die "test accepts --provider NAME or --all" ;; esac; [[ $# -eq 0 ]] || die "unexpected notify test arguments"; dispatch_event notification.test "" "runnerctl notification test" "$provider"
}
cmd_emit(){
  local event="${1:-}" message="" runner=""; [[ -n "$event" ]] || die "notify emit requires EVENT"; shift || true
  while [[ $# -gt 0 ]]; do case "$1" in --message) message="${2:-}"; shift 2 ;; --runner) runner="${2:-}"; shift 2 ;; *) die "unknown notify emit option: $1" ;; esac; done
  [[ "$event" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid event name"; dispatch_event "$event" "$runner" "$message" ""
}

main(){
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    status) cmd_status "$@" ;;
    providers) cmd_providers "$@" ;;
    test) cmd_test "$@" ;;
    emit) cmd_emit "$@" ;;
    enable) cmd_enable "$@" ;;
    disable) cmd_disable "$@" ;;
    hook) cmd_hook "$@" ;;
    help|--help|-h|"") usage ;;
    *) die "unknown notify command: $cmd" ;;
  esac
}
main "$@"
