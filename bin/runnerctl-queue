#!/usr/bin/env bash
set -euo pipefail
RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
find_legacy(){
  local candidates=(
    "${RUNNERCTL_QUEUE_LEGACY_HELPER:-}"
    "$SCRIPT_DIR/runnerctl-queue-legacy"
    "$SCRIPT_DIR/../runnerctl-queue-legacy"
    "$SCRIPT_DIR/../libexec/runnerctl-queue-legacy"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-queue-legacy"
  ) candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return
  done
  printf 'runnerctl-queue: legacy queue helper not found; reinstall runnerctl\n' >&2
  exit 1
}
scheduler_enabled(){ local f="$RUNNERCTL_HOME/scheduler/config"; [[ -f "$f" ]] || return 1; [[ "$(awk -F= '$1=="enabled"{print $2;exit}' "$f" 2>/dev/null || true)" == true ]]; }
case "${1:-}" in
  help|--help|-h|"")
    cat <<'EOF'
Legacy host-side admission gate (v0.4 compatibility mode).

This command blocks inside the GitHub runner job-start hook after GitHub has
already assigned the job. Waiting jobs therefore appear as "in progress", and
the waiting time can consume part of `timeout-minutes`.

For GitHub-native queued semantics use:
  runnerctl scheduler --help

EOF
    exec bash "$(find_legacy)" --help
    ;;
  enable)
    if scheduler_enabled; then printf '[runnerctl-queue] ERROR: GitHub-native scheduler is enabled; disable it before enabling the legacy queue gate.\n' >&2; exit 1; fi
    exec bash "$(find_legacy)" "$@"
    ;;
  *) exec bash "$(find_legacy)" "$@" ;;
esac
