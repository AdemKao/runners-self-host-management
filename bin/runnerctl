#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
RUNNERS_DIR="$RUNNERCTL_HOME/runners"
CACHE_DIR="$RUNNERCTL_HOME/cache"
DEFAULT_LABELS="local"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '[runnerctl] %s\n' "$*"; }
warn() { printf '[runnerctl] WARN: %s\n' "$*" >&2; }
die() { printf '[runnerctl] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
runnerctl - manage GitHub Actions self-hosted runners on one machine

Usage:
  runnerctl doctor
  runnerctl add OWNER/REPO [--count N] [--labels a,b] [--name-prefix PREFIX]
  runnerctl list
  runnerctl status [RUNNER]
  runnerctl start RUNNER
  runnerctl stop RUNNER
  runnerctl restart RUNNER
  runnerctl start-all
  runnerctl stop-all
  runnerctl logs RUNNER [--no-follow]
  runnerctl job-logs RUNNER [--no-follow]
  runnerctl remove RUNNER [--yes]
  runnerctl version

Environment:
  RUNNERCTL_HOME   Data directory (default: ~/.local/share/runnerctl)
  GH_TOKEN         Optional GitHub token used by gh; runnerctl never stores it
  GH_HOST          Optional GitHub host for gh authentication
USAGE
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"; }
ensure_dirs() { mkdir -p "$RUNNERS_DIR" "$CACHE_DIR"; }

host_short() {
  hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-' | sed 's/^-//;s/-$//' || printf 'local'
}

platform_asset() {
  local os arch
  os="$(uname -s)"
  arch="$(uname -m)"
  case "$os/$arch" in
    Darwin/arm64) echo "osx-arm64" ;;
    Darwin/x86_64) echo "osx-x64" ;;
    Linux/x86_64) echo "linux-x64" ;;
    Linux/aarch64|Linux/arm64) echo "linux-arm64" ;;
    *) die "Unsupported platform: $os $arch" ;;
  esac
}

runner_dir() { printf '%s/%s' "$RUNNERS_DIR" "$1"; }
meta_get() {
  local dir="$1" key="$2"
  awk -F= -v k="$key" '$1 == k {sub(/^[^=]*=/, ""); print; exit}' "$dir/.runnerctl-meta" 2>/dev/null || true
}

require_runner() {
  local dir
  dir="$(runner_dir "$1")"
  [[ -d "$dir" && -f "$dir/.runnerctl-meta" ]] || die "Unknown runner: $1"
  printf '%s' "$dir"
}

service_state() {
  local dir="$1" service=""
  service="$(cat "$dir/.service" 2>/dev/null || true)"
  [[ -n "$service" ]] || { echo "not-installed"; return; }
  case "$(uname -s)" in
    Darwin)
      if launchctl list 2>/dev/null | grep -Fq "$service"; then echo "running"; else echo "stopped"; fi
      ;;
    Linux)
      if systemctl is-active --quiet "$service" 2>/dev/null; then echo "running"; else echo "stopped"; fi
      ;;
    *) echo "unknown" ;;
  esac
}

svc() {
  local dir="$1" action="$2"
  [[ -x "$dir/svc.sh" ]] || die "svc.sh not found for $(basename "$dir")"
  if [[ "$(uname -s)" == "Linux" ]]; then
    (cd "$dir" && sudo ./svc.sh "$action")
  else
    (cd "$dir" && ./svc.sh "$action")
  fi
}

gh_api() {
  need_cmd gh
  gh api -H "X-GitHub-Api-Version: 2026-03-10" "$@"
}

registration_token() {
  local repo="$1"
  gh_api -X POST "repos/$repo/actions/runners/registration-token" --jq .token
}

remove_token() {
  local repo="$1"
  gh_api -X POST "repos/$repo/actions/runners/remove-token" --jq .token
}

latest_runner_version() {
  gh_api repos/actions/runner/releases/latest --jq .tag_name | sed 's/^v//'
}

download_runner() {
  local version="$1" asset="$2" archive url
  archive="$CACHE_DIR/actions-runner-${asset}-${version}.tar.gz"
  if [[ -s "$archive" ]]; then
    printf '%s' "$archive"
    return
  fi
  need_cmd curl
  url="https://github.com/actions/runner/releases/download/v${version}/actions-runner-${asset}-${version}.tar.gz"
  info "Downloading GitHub Actions runner v${version} (${asset})..." >&2
  curl -fL --retry 3 --retry-delay 2 -o "$archive.tmp" "$url"
  mv "$archive.tmp" "$archive"
  printf '%s' "$archive"
}

write_meta() {
  local dir="$1" name="$2" repo="$3" labels="$4" version="$5"
  cat > "$dir/.runnerctl-meta" <<EOF_META
name=$name
repo=$repo
labels=$labels
version=$version
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF_META
}

cmd_doctor() {
  bold "runnerctl doctor"
  printf 'version: %s\n' "$VERSION"
  printf 'home: %s\n' "$RUNNERCTL_HOME"
  printf 'platform: %s (%s)\n' "$(uname -s)" "$(uname -m)"
  for c in gh curl tar; do
    if command -v "$c" >/dev/null 2>&1; then printf '%-8s OK (%s)\n' "$c" "$(command -v "$c")"; else printf '%-8s MISSING\n' "$c"; fi
  done
  if command -v gh >/dev/null 2>&1; then
    printf 'gh auth:\n'
    gh auth status 2>&1 | sed 's/^/  /' || true
  fi
}

cmd_add() {
  local repo="${1:-}" count=1 labels="$DEFAULT_LABELS" prefix="" asset version archive repo_slug host i name dir token
  [[ "$repo" =~ ^[^/]+/[^/]+$ ]] || die "Repository must be OWNER/REPO"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --count) count="${2:-}"; shift 2 ;;
      --labels) labels="${2:-}"; shift 2 ;;
      --name-prefix) prefix="${2:-}"; shift 2 ;;
      *) die "Unknown add option: $1" ;;
    esac
  done
  [[ "$count" =~ ^[1-9][0-9]*$ ]] || die "--count must be a positive integer"
  ensure_dirs
  need_cmd gh; need_cmd tar
  gh auth status >/dev/null 2>&1 || die "GitHub CLI is not authenticated. Run: gh auth login"

  asset="$(platform_asset)"
  version="$(latest_runner_version)"
  archive="$(download_runner "$version" "$asset")"
  repo_slug="$(printf '%s' "$repo" | tr '/' '-' | tr '[:upper:]' '[:lower:]')"
  host="$(host_short)"
  [[ -n "$prefix" ]] || prefix="${repo_slug}-${host}"

  for ((i=1; i<=count; i++)); do
    name="${prefix}-$(printf '%02d' "$i")"
    dir="$(runner_dir "$name")"
    [[ ! -e "$dir" ]] || die "Runner directory already exists: $dir"
    mkdir -p "$dir"
    info "Installing $name for $repo"
    tar -xzf "$archive" -C "$dir"
    token="$(registration_token "$repo")"
    (
      cd "$dir"
      ./config.sh --unattended \
        --url "https://github.com/$repo" \
        --token "$token" \
        --name "$name" \
        --labels "$labels" \
        --work "_work"
    )
    write_meta "$dir" "$name" "$repo" "$labels" "$version"
    svc "$dir" install
    svc "$dir" start
    info "Ready: $name ($(service_state "$dir"))"
  done
}

cmd_list() {
  ensure_dirs
  printf '%-38s %-24s %-12s %s\n' "NAME" "REPOSITORY" "STATUS" "LABELS"
  local dir name repo labels
  shopt -s nullglob
  for dir in "$RUNNERS_DIR"/*; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    name="$(meta_get "$dir" name)"
    repo="$(meta_get "$dir" repo)"
    labels="$(meta_get "$dir" labels)"
    printf '%-38s %-24s %-12s %s\n' "$name" "$repo" "$(service_state "$dir")" "$labels"
  done
}

cmd_status() {
  if [[ $# -eq 0 ]]; then cmd_list; return; fi
  local dir
  dir="$(require_runner "$1")"
  printf '%s: %s\n' "$1" "$(service_state "$dir")"
  if [[ -x "$dir/svc.sh" ]]; then
    (cd "$dir" && ./svc.sh status) || true
  fi
}

cmd_service_one() {
  local action="$1" name="$2" dir
  dir="$(require_runner "$name")"
  svc "$dir" "$action"
  printf '%s: %s\n' "$name" "$(service_state "$dir")"
}

cmd_all() {
  local action="$1" dir name
  ensure_dirs
  shopt -s nullglob
  for dir in "$RUNNERS_DIR"/*; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    name="$(basename "$dir")"
    info "$action $name"
    svc "$dir" "$action" || warn "Failed: $name"
  done
}

latest_log() {
  local dir="$1" kind="$2"
  find "$dir/_diag" -maxdepth 1 -type f -name "${kind}_*.log" -print 2>/dev/null | sort | tail -n 1
}

cmd_logs() {
  local kind="$1" name="$2" follow=1 dir file
  shift 2
  if [[ "${1:-}" == "--no-follow" ]]; then follow=0; fi
  dir="$(require_runner "$name")"
  file="$(latest_log "$dir" "$kind")"
  [[ -n "$file" ]] || die "No ${kind} log found for $name"
  info "$file"
  if [[ "$follow" -eq 1 ]]; then tail -n 200 -f "$file"; else tail -n 200 "$file"; fi
}

cmd_remove() {
  local name="${1:-}" yes=0 dir repo token
  [[ -n "$name" ]] || die "remove requires RUNNER"
  shift || true
  [[ "${1:-}" == "--yes" ]] && yes=1
  dir="$(require_runner "$name")"
  repo="$(meta_get "$dir" repo)"
  if [[ "$yes" -ne 1 ]]; then
    printf 'Remove runner %s from %s and delete %s? [y/N] ' "$name" "$repo" "$dir"
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || { info "Cancelled"; return; }
  fi
  if [[ "$(service_state "$dir")" == "running" ]]; then svc "$dir" stop; fi
  if [[ -f "$dir/.service" ]]; then svc "$dir" uninstall || true; fi
  token="$(remove_token "$repo")"
  (cd "$dir" && ./config.sh remove --token "$token")
  rm -rf "$dir"
  info "Removed: $name"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    add) cmd_add "$@" ;;
    list) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    start) [[ $# -eq 1 ]] || die "start requires RUNNER"; cmd_service_one start "$1" ;;
    stop) [[ $# -eq 1 ]] || die "stop requires RUNNER"; cmd_service_one stop "$1" ;;
    restart) [[ $# -eq 1 ]] || die "restart requires RUNNER"; cmd_service_one stop "$1"; cmd_service_one start "$1" ;;
    start-all) cmd_all start ;;
    stop-all) cmd_all stop ;;
    logs) [[ $# -ge 1 ]] || die "logs requires RUNNER"; cmd_logs Runner "$@" ;;
    job-logs) [[ $# -ge 1 ]] || die "job-logs requires RUNNER"; cmd_logs Worker "$@" ;;
    remove) cmd_remove "$@" ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h) usage ;;
    *) usage >&2; die "Unknown command: $cmd" ;;
  esac
}

main "$@"
