#!/usr/bin/env bash
set -euo pipefail
VERSION="0.8.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
find_v07(){
  local candidates=("${RUNNERCTL_CORE_V07:-}" "$SCRIPT_DIR/runnerctl-v07" "$SCRIPT_DIR/runnerctl-core-v07" "$SCRIPT_DIR/../libexec/runnerctl-core-v07" "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-core-v07") candidate
  for candidate in "${candidates[@]}"; do [[ -n "$candidate" && -f "$candidate" ]] || continue; printf '%s' "$candidate"; return; done
  printf 'runnerctl: v0.7 compatibility core not found. Reinstall runnerctl.\n' >&2; exit 1
}
find_monitor(){
  local candidates=("${RUNNERCTL_MONITOR_HELPER:-}" "$SCRIPT_DIR/runnerctl-monitor" "$SCRIPT_DIR/../libexec/runnerctl-monitor" "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-monitor") candidate
  for candidate in "${candidates[@]}"; do [[ -n "$candidate" && -f "$candidate" ]] || continue; printf '%s' "$candidate"; return; done
  printf 'runnerctl: monitor helper not found. Reinstall runnerctl.\n' >&2; exit 1
}
case "${1:-}" in
  version|--version|-v) printf '%s\n' "$VERSION" ;;
  monitor) shift || true; exec bash "$(find_monitor)" "$@" ;;
  doctor) bash "$(find_v07)" "$@" | sed -E "s/^version: .*/version: $VERSION/" ;;
  *) exec bash "$(find_v07)" "$@" ;;
esac