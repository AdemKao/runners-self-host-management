#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.2"
RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
RUNNERS_DIR="$RUNNERCTL_HOME/runners"
CACHE_DIR="$RUNNERCTL_HOME/cache"
RUNNERCTL_CONFIG_HOME="${RUNNERCTL_CONFIG_HOME:-$HOME/.config/runnerctl}"
ACCOUNT_MAP_FILE="$RUNNERCTL_CONFIG_HOME/accounts.tsv"
DEFAULT_LABELS="local"
GITHUB_HOST="${RUNNERCTL_GITHUB_HOST:-${GH_HOST:-github.com}}"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '[runnerctl] %s\n' "$*"; }
warn() { printf '[runnerctl] WARN: %s\n' "$*" >&2; }
die() { printf '[runnerctl] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
runnerctl - manage GitHub Actions self-hosted runners on one machine

Usage:
  runnerctl doctor
  runnerctl auth list
  runnerctl auth status
  runnerctl auth use ACCOUNT
  runnerctl auth login [GH_AUTH_LOGIN_OPTIONS...]
  runnerctl auth setup-git
  runnerctl auth doctor
  runnerctl auth map OWNER/REPO|OWNER/* ACCOUNT
  runnerctl auth unmap OWNER/REPO|OWNER/*
  runnerctl auth mappings
  runnerctl auth resolve OWNER/REPO
  runnerctl add OWNER/REPO [--count N] [--labels a,b] [--name-prefix PREFIX] [--account ACCOUNT]
  runnerctl list
  runnerctl status [RUNNER]
  runnerctl start RUNNER
  runnerctl stop RUNNER
  runnerctl restart RUNNER
  runnerctl start-all
  runnerctl stop-all
  runnerctl logs RUNNER [--no-follow]
  runnerctl job-logs RUNNER [--no-follow]
  runnerctl remove RUNNER [--yes] [--account ACCOUNT]
  runnerctl version

Environment:
  RUNNERCTL_HOME         Data directory (default: ~/.local/share/runnerctl)
  RUNNERCTL_CONFIG_HOME  Config directory (default: ~/.config/runnerctl)
  RUNNERCTL_GITHUB_HOST  GitHub host (default: GH_HOST or github.com)
  GH_TOKEN               Optional token override understood by gh
  GH_HOST                Optional GitHub host understood by gh
USAGE
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"; }
ensure_dirs() { mkdir -p "$RUNNERS_DIR" "$CACHE_DIR" "$RUNNERCTL_CONFIG_HOME"; }
ensure_config_dirs() { mkdir -p "$RUNNERCTL_CONFIG_HOME"; }

host_short() {
  hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-' | sed 's/^-//;s/-$//' || printf 'local'
}

platform_asset() {
  local os arch
  os="$(uname -s)"
  arch="$(uname -m)"
  case "$os/$arch" in
    Darwin/arm64) echo "osx-arm64" ;;
    Darwin/x86_64) echo "osx-x64" ;;
    Linux/x86_64) echo "linux-x64" ;;
    Linux/aarch64|Linux/arm64) echo "linux-arm64" ;;
    *) die "Unsupported platform: $os $arch" ;;
  esac
}

runner_dir() { printf '%s/%s' "$RUNNERS_DIR" "$1"; }

meta_get() {
  local dir="$1" key="$2"
  awk -F= -v k="$key" '$1 == k {sub(/^[^=]*=/, ""); print; exit}' "$dir/.runnerctl-meta" 2>/dev/null || true
}

require_runner() {
  local dir
  dir="$(runner_dir "$1")"
  [[ -d "$dir" && -f "$dir/.runnerctl-meta" ]] || die "Unknown runner: $1"
  printf '%s' "$dir"
}

launchd_service_label() {
  local service="$1"
  service="${service##*/}"
  service="${service%.plist}"
  printf '%s' "$service"
}

launchd_service_running() {
  local service="$1" label domain output
  label="$(launchd_service_label "$service")"
  [[ -n "$label" ]] || return 1
  domain="gui/$(id -u)"

  if output="$(launchctl print "$domain/$label" 2>/dev/null)"; then
    if printf '%s\n' "$output" | grep -Eq '^[[:space:]]*state = running([[:space:]]|$)'; then
      return 0
    fi
    if printf '%s\n' "$output" | grep -Eq '^[[:space:]]*pid = [1-9][0-9]*([[:space:]]|$)'; then
      return 0
    fi
    return 1
  fi

  launchctl list 2>/dev/null | awk -v label="$label" '$3 == label && $1 ~ /^[0-9]+$/ { found=1 } END { exit(found ? 0 : 1) }'
}

service_state() {
  local dir="$1" service=""
  service="$(cat "$dir/.service" 2>/dev/null || true)"
  [[ -n "$service" ]] || { echo "not-installed"; return; }
  case "$(uname -s)" in
    Darwin)
      if launchd_service_running "$service"; then echo "running"; else echo "stopped"; fi
      ;;
    Linux)
      if systemctl is-active --quiet "$service" 2>/dev/null; then echo "running"; else echo "stopped"; fi
      ;;
    *) echo "unknown" ;;
  esac
}

svc() {
  local dir="$1" action="$2"
  [[ -x "$dir/svc.sh" ]] || die "svc.sh not found for $(basename "$dir")"
  if [[ "$(uname -s)" == "Linux" ]]; then
    (cd "$dir" && sudo ./svc.sh "$action")
  else
    (cd "$dir" && ./svc.sh "$action")
  fi
}

active_account() {
  need_cmd gh
  gh auth status --active --hostname "$GITHUB_HOST" --json hosts \
    --jq ".hosts[\"$GITHUB_HOST\"][] | select(.active == true) | .login" 2>/dev/null | head -n 1
}

account_is_logged_in() {
  local account="$1"
  gh auth token --hostname "$GITHUB_HOST" --user "$account" >/dev/null 2>&1
}

require_account() {
  local account="$1"
  [[ -n "$account" ]] || die "No GitHub account selected. Run: runnerctl auth login"
  account_is_logged_in "$account" || die "GitHub account '$account' is not authenticated for $GITHUB_HOST. Run: runnerctl auth login"
}

account_token() {
  local account="$1"
  require_account "$account"
  gh auth token --hostname "$GITHUB_HOST" --user "$account"
}

gh_api_as() {
  local account="$1"
  shift
  local token
  token="$(account_token "$account")"
  GH_TOKEN="$token" GH_HOST="$GITHUB_HOST" gh api -H "X-GitHub-Api-Version: 2026-03-10" "$@"
}

map_lookup_exact() {
  local pattern="$1"
  [[ -f "$ACCOUNT_MAP_FILE" ]] || return 0
  awk -F '\t' -v p="$pattern" '$1 == p {print $2; exit}' "$ACCOUNT_MAP_FILE"
}

resolve_account() {
  local repo="$1" exact owner wildcard account
  exact="$(map_lookup_exact "$repo")"
  if [[ -n "$exact" ]]; then
    printf '%s' "$exact"
    return
  fi
  owner="${repo%%/*}"
  wildcard="${owner}/*"
  account="$(map_lookup_exact "$wildcard")"
  if [[ -n "$account" ]]; then
    printf '%s' "$account"
    return
  fi
  active_account || true
}

registration_token() {
  local repo="$1" account="$2"
  gh_api_as "$account" -X POST "repos/$repo/actions/runners/registration-token" --jq .token
}

remove_token() {
  local repo="$1" account="$2"
  gh_api_as "$account" -X POST "repos/$repo/actions/runners/remove-token" --jq .token
}

latest_runner_version() {
  local account="$1"
  gh_api_as "$account" repos/actions/runner/releases/latest --jq .tag_name | sed 's/^v//'
}

download_runner() {
  local version="$1" asset="$2" archive url
  archive="$CACHE_DIR/actions-runner-${asset}-${version}.tar.gz"
  if [[ -s "$archive" ]]; then
    printf '%s' "$archive"
    return
  fi
  need_cmd curl
  url="https://github.com/actions/runner/releases/download/v${version}/actions-runner-${asset}-${version}.tar.gz"
  info "Downloading GitHub Actions runner v${version} (${asset})..." >&2
  curl -fL --retry 3 --retry-delay 2 -o "$archive.tmp" "$url"
  mv "$archive.tmp" "$archive"
  printf '%s' "$archive"
}

write_meta() {
  local dir="$1" name="$2" repo="$3" labels="$4" version="$5" account="$6"
  cat > "$dir/.runnerctl-meta" <<EOF_META
name=$name
repo=$repo
labels=$labels
version=$version
account=$account
created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF_META
}

cmd_auth_list() {
  need_cmd gh
  printf 'GitHub host: %s\n' "$GITHUB_HOST"
  gh auth status --hostname "$GITHUB_HOST" --json hosts \
    --jq ".hosts[\"$GITHUB_HOST\"][] | [if .active then \"*\" else \" \" end, .login, (.state // \"unknown\")] | @tsv" \
    2>/dev/null | awk -F '\t' '{printf "%s %-24s %s\n", $1, $2, $3}' \
    || gh auth status --hostname "$GITHUB_HOST"
}

cmd_auth_status() {
  need_cmd gh
  gh auth status --hostname "$GITHUB_HOST"
}

cmd_auth_use() {
  local account="${1:-}"
  [[ -n "$account" ]] || die "auth use requires ACCOUNT"
  need_cmd gh
  account_is_logged_in "$account" || die "GitHub account '$account' is not authenticated for $GITHUB_HOST"
  gh auth switch --hostname "$GITHUB_HOST" --user "$account"
  info "Active GitHub account: $account"
}

cmd_auth_login() {
  need_cmd gh
  gh auth login --hostname "$GITHUB_HOST" "$@"
}

cmd_auth_setup_git() {
  need_cmd gh
  gh auth setup-git --hostname "$GITHUB_HOST"
  info "Configured Git credential helper for $GITHUB_HOST"
}

cmd_auth_map() {
  local pattern="${1:-}" account="${2:-}" tmp
  [[ "$pattern" =~ ^[^/]+/([^/]+|\*)$ ]] || die "Mapping must be OWNER/REPO or OWNER/*"
  [[ -n "$account" ]] || die "auth map requires ACCOUNT"
  need_cmd gh
  require_account "$account"
  ensure_config_dirs
  tmp="$(mktemp)"
  if [[ -f "$ACCOUNT_MAP_FILE" ]]; then
    awk -F '\t' -v p="$pattern" '$1 != p' "$ACCOUNT_MAP_FILE" > "$tmp"
  fi
  printf '%s\t%s\n' "$pattern" "$account" >> "$tmp"
  mv "$tmp" "$ACCOUNT_MAP_FILE"
  chmod 600 "$ACCOUNT_MAP_FILE"
  info "Mapped $pattern -> $account"
}

cmd_auth_unmap() {
  local pattern="${1:-}" tmp
  [[ -n "$pattern" ]] || die "auth unmap requires OWNER/REPO or OWNER/*"
  ensure_config_dirs
  [[ -f "$ACCOUNT_MAP_FILE" ]] || { info "No mappings configured"; return; }
  tmp="$(mktemp)"
  awk -F '\t' -v p="$pattern" '$1 != p' "$ACCOUNT_MAP_FILE" > "$tmp"
  mv "$tmp" "$ACCOUNT_MAP_FILE"
  chmod 600 "$ACCOUNT_MAP_FILE"
  info "Removed mapping: $pattern"
}

cmd_auth_mappings() {
  ensure_config_dirs
  printf '%-34s %s\n' "REPOSITORY PATTERN" "ACCOUNT"
  [[ -f "$ACCOUNT_MAP_FILE" ]] || return 0
  awk -F '\t' 'NF >= 2 {printf "%-34s %s\n", $1, $2}' "$ACCOUNT_MAP_FILE"
}

cmd_auth_resolve() {
  local repo="${1:-}" account
  [[ "$repo" =~ ^[^/]+/[^/]+$ ]] || die "Repository must be OWNER/REPO"
  account="$(resolve_account "$repo")"
  [[ -n "$account" ]] || die "No account mapping or active GitHub account found for $repo"
  printf '%s\n' "$account"
}

cmd_auth_doctor() {
  bold "runnerctl auth doctor"
  need_cmd gh
  printf 'host: %s\n' "$GITHUB_HOST"
  local active protocol remote repo mapped
  active="$(active_account || true)"
  printf 'active account: %s\n' "${active:-none}"
  protocol="$(gh config get git_protocol --host "$GITHUB_HOST" 2>/dev/null || true)"
  printf 'git protocol: %s\n' "${protocol:-unknown}"
  printf 'config: %s\n' "$ACCOUNT_MAP_FILE"

  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    remote="$(git remote get-url origin 2>/dev/null || true)"
    printf 'current origin: %s\n' "${remote:-none}"
    repo=""
    case "$remote" in
      https://"$GITHUB_HOST"/*)
        repo="${remote#https://$GITHUB_HOST/}"
        repo="${repo%.git}"
        ;;
      git@"$GITHUB_HOST":*)
        repo="${remote#git@$GITHUB_HOST:}"
        repo="${repo%.git}"
        ;;
      ssh://git@"$GITHUB_HOST"/*)
        repo="${remote#ssh://git@$GITHUB_HOST/}"
        repo="${repo%.git}"
        ;;
    esac
    if [[ "$remote" == git@*:* || "$remote" == ssh://* ]]; then
      warn "SSH remote detected. 'runnerctl auth use' switches gh accounts, but SSH key selection is controlled by ~/.ssh/config."
    fi
    if [[ -n "$repo" && "$repo" =~ ^[^/]+/[^/]+$ ]]; then
      mapped="$(resolve_account "$repo")"
      printf 'resolved runner account: %s\n' "${mapped:-none}"
    fi
  fi
}

cmd_auth() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    list) cmd_auth_list "$@" ;;
    status) cmd_auth_status "$@" ;;
    use) cmd_auth_use "$@" ;;
    login) cmd_auth_login "$@" ;;
    setup-git) cmd_auth_setup_git "$@" ;;
    doctor) cmd_auth_doctor "$@" ;;
    map) [[ $# -eq 2 ]] || die "auth map requires PATTERN ACCOUNT"; cmd_auth_map "$@" ;;
    unmap) [[ $# -eq 1 ]] || die "auth unmap requires PATTERN"; cmd_auth_unmap "$@" ;;
    mappings) cmd_auth_mappings "$@" ;;
    resolve) [[ $# -eq 1 ]] || die "auth resolve requires OWNER/REPO"; cmd_auth_resolve "$@" ;;
    *) die "Unknown auth command: $sub" ;;
  esac
}

cmd_doctor() {
  bold "runnerctl doctor"
  printf 'version: %s\n' "$VERSION"
  printf 'home: %s\n' "$RUNNERCTL_HOME"
  printf 'config home: %s\n' "$RUNNERCTL_CONFIG_HOME"
  printf 'platform: %s (%s)\n' "$(uname -s)" "$(uname -m)"
  for c in gh curl tar; do
    if command -v "$c" >/dev/null 2>&1; then printf '%-8s OK (%s)\n' "$c" "$(command -v "$c")"; else printf '%-8s MISSING\n' "$c"; fi
  done
  if command -v gh >/dev/null 2>&1; then
    printf 'gh active account: %s\n' "$(active_account || printf 'none')"
  fi
}

cmd_add() {
  local repo="${1:-}" count=1 labels="$DEFAULT_LABELS" prefix="" account="" asset version archive repo_slug host i name dir token
  [[ "$repo" =~ ^[^/]+/[^/]+$ ]] || die "Repository must be OWNER/REPO"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --count) count="${2:-}"; shift 2 ;;
      --labels) labels="${2:-}"; shift 2 ;;
      --name-prefix) prefix="${2:-}"; shift 2 ;;
      --account) account="${2:-}"; shift 2 ;;
      *) die "Unknown add option: $1" ;;
    esac
  done
  [[ "$count" =~ ^[1-9][0-9]*$ ]] || die "--count must be a positive integer"
  ensure_dirs
  need_cmd gh; need_cmd tar
  [[ -n "$account" ]] || account="$(resolve_account "$repo")"
  require_account "$account"

  info "Using GitHub account: $account"
  asset="$(platform_asset)"
  version="$(latest_runner_version "$account")"
  archive="$(download_runner "$version" "$asset")"
  repo_slug="$(printf '%s' "$repo" | tr '/' '-' | tr '[:upper:]' '[:lower:]')"
  host="$(host_short)"
  [[ -n "$prefix" ]] || prefix="${repo_slug}-${host}"

  for ((i=1; i<=count; i++)); do
    name="${prefix}-$(printf '%02d' "$i")"
    dir="$(runner_dir "$name")"
    [[ ! -e "$dir" ]] || die "Runner directory already exists: $dir"
    mkdir -p "$dir"
    info "Installing $name for $repo"
    tar -xzf "$archive" -C "$dir"
    token="$(registration_token "$repo" "$account")"
    (
      cd "$dir"
      ./config.sh --unattended \
        --url "https://$GITHUB_HOST/$repo" \
        --token "$token" \
        --name "$name" \
        --labels "$labels" \
        --work "_work"
    )
    write_meta "$dir" "$name" "$repo" "$labels" "$version" "$account"
    svc "$dir" install
    svc "$dir" start
    info "Ready: $name ($(service_state "$dir"))"
  done
}

cmd_list() {
  ensure_dirs
  printf '%-38s %-24s %-18s %-12s %s\n' "NAME" "REPOSITORY" "ACCOUNT" "STATUS" "LABELS"
  local dir name repo labels account
  shopt -s nullglob
  for dir in "$RUNNERS_DIR"/*; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    name="$(meta_get "$dir" name)"
    repo="$(meta_get "$dir" repo)"
    labels="$(meta_get "$dir" labels)"
    account="$(meta_get "$dir" account)"
    [[ -n "$account" ]] || account="$(resolve_account "$repo")"
    printf '%-38s %-24s %-18s %-12s %s\n' "$name" "$repo" "${account:-unknown}" "$(service_state "$dir")" "$labels"
  done
}

cmd_status() {
  if [[ $# -eq 0 ]]; then cmd_list; return; fi
  local dir
  dir="$(require_runner "$1")"
  printf '%s: %s\n' "$1" "$(service_state "$dir")"
  if [[ -x "$dir/svc.sh" ]]; then
    (cd "$dir" && ./svc.sh status) || true
  fi
}

cmd_service_one() {
  local action="$1" name="$2" dir
  dir="$(require_runner "$name")"
  svc "$dir" "$action"
  printf '%s: %s\n' "$name" "$(service_state "$dir")"
}

cmd_all() {
  local action="$1" dir name
  ensure_dirs
  shopt -s nullglob
  for dir in "$RUNNERS_DIR"/*; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    name="$(basename "$dir")"
    info "$action $name"
    svc "$dir" "$action" || warn "Failed: $name"
  done
}

latest_log() {
  local dir="$1" kind="$2"
  find "$dir/_diag" -maxdepth 1 -type f -name "${kind}_*.log" -print 2>/dev/null | sort | tail -n 1
}

cmd_logs() {
  local kind="$1" name="$2" follow=1 dir file
  shift 2
  if [[ "${1:-}" == "--no-follow" ]]; then follow=0; fi
  dir="$(require_runner "$name")"
  file="$(latest_log "$dir" "$kind")"
  [[ -n "$file" ]] || die "No ${kind} log found for $name"
  info "$file"
  if [[ "$follow" -eq 1 ]]; then tail -n 200 -f "$file"; else tail -n 200 "$file"; fi
}

cmd_remove() {
  local name="${1:-}" yes=0 account_override="" dir repo token account
  [[ -n "$name" ]] || die "remove requires RUNNER"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --account) account_override="${2:-}"; shift 2 ;;
      *) die "Unknown remove option: $1" ;;
    esac
  done
  dir="$(require_runner "$name")"
  repo="$(meta_get "$dir" repo)"
  account="$(meta_get "$dir" account)"
  [[ -n "$account_override" ]] && account="$account_override"
  [[ -n "$account" ]] || account="$(resolve_account "$repo")"
  require_account "$account"

  if [[ "$yes" -ne 1 ]]; then
    printf 'Remove runner %s from %s using account %s and delete %s? [y/N] ' "$name" "$repo" "$account" "$dir"
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || { info "Cancelled"; return; }
  fi
  if [[ "$(service_state "$dir")" == "running" ]]; then svc "$dir" stop; fi
  if [[ -f "$dir/.service" ]]; then svc "$dir" uninstall || true; fi
  token="$(remove_token "$repo" "$account")"
  (cd "$dir" && ./config.sh remove --token "$token")
  rm -rf "$dir"
  info "Removed: $name"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    auth) cmd_auth "$@" ;;
    add) cmd_add "$@" ;;
    list) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    start) [[ $# -eq 1 ]] || die "start requires RUNNER"; cmd_service_one start "$1" ;;
    stop) [[ $# -eq 1 ]] || die "stop requires RUNNER"; cmd_service_one stop "$1" ;;
    restart) [[ $# -eq 1 ]] || die "restart requires RUNNER"; cmd_service_one stop "$1"; cmd_service_one start "$1" ;;
    start-all) cmd_all start ;;
    stop-all) cmd_all stop ;;
    logs) [[ $# -ge 1 ]] || die "logs requires RUNNER"; cmd_logs Runner "$@" ;;
    job-logs) [[ $# -ge 1 ]] || die "job-logs requires RUNNER"; cmd_logs Worker "$@" ;;
    remove) cmd_remove "$@" ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h) usage ;;
    *) usage >&2; die "Unknown command: $cmd" ;;
  esac
}

main "$@"
