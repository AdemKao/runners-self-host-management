EOF
}

command_help() {
  local command="${1:-}"
  case "$command" in
    add)
      cat <<'EOF'
Register one or more GitHub Actions self-hosted runners.

Usage:
  runnerctl add OWNER/REPO [flags]

Flags:
  --count N              Number of runner instances (default: 1)
  --labels a,b           Custom labels (default: local)
  --name-prefix PREFIX   Runner name prefix
  --account ACCOUNT      GitHub CLI account to use
  -h, --help             Show help

Side effects:
  - Downloads the official GitHub Actions runner.
  - Requests a short-lived registration token from GitHub.
  - Registers runner instances with the repository.
  - Creates local runner directories.
  - Installs and starts launchd/systemd services.

AI AGENT:
  MUTATING. Run `runnerctl doctor`, `runnerctl auth resolve OWNER/REPO`, and
  `runnerctl list` first. Prefer an explicit --account or an existing mapping.
EOF
      ;;
    list)
      cat <<'EOF'
List locally managed runners.

Usage:
  runnerctl list [--json]

Flags:
  --json       Emit stable machine-readable JSON
  -h, --help   Show help

Side effects:
  None (read-only).

AI AGENT:
  Prefer --json for automation.
EOF
      ;;
    status)
      cat <<'EOF'
Show runner service status.

Usage:
  runnerctl status [RUNNER] [--json]

Flags:
  --json       Emit stable machine-readable JSON
  -h, --help   Show help

Side effects:
  None (read-only).
EOF
      ;;
    doctor)
      cat <<'EOF'
Check the local runnerctl environment and dependencies.

Usage:
  runnerctl doctor [--json]

Flags:
  --json       Emit stable machine-readable JSON
  -h, --help   Show help

Side effects:
  None (read-only).

AI AGENT:
  This should normally be the first runnerctl command an agent executes.
EOF
      ;;
    host)
      cat <<'EOF'
Inspect or bootstrap host prerequisites for self-hosted runners.

Usage:
  runnerctl host inspect [--json]
  runnerctl host bootstrap [--dry-run] [--json]

Commands:
  inspect      Read-only OS, package-manager, and dependency inspection
  bootstrap    Install missing git/gh/curl/tar prerequisites

Safety:
  - `host bootstrap --dry-run` is read-only.
  - `host bootstrap` mutates system packages and may invoke sudo.
  - It does not configure swap, firewall, Docker, credentials, or runner registration.
  - macOS requires Homebrew to already be installed.

AI AGENT:
  Prefer `runnerctl host inspect --json` and `runnerctl host bootstrap --dry-run --json`
  before allowing package mutations.
EOF
      ;;
    auth)
      cat <<'EOF'
Manage GitHub CLI accounts and repository-to-account mappings.

Usage:
  runnerctl auth [command]

Commands:
  list                 List authenticated GitHub accounts
  status               Show GitHub authentication status
  use ACCOUNT          Change the global active gh account
  login [...]          Run GitHub CLI login
  setup-git            Configure Git credential helper through gh
  doctor               Inspect auth/repository context
  map PATTERN ACCOUNT  Map OWNER/REPO or OWNER/* to an account
  unmap PATTERN        Remove a mapping
  mappings             List mappings
  resolve OWNER/REPO   Resolve the account runnerctl will use

JSON-capable discovery commands:
  runnerctl auth list --json
  runnerctl auth status --json
  runnerctl auth doctor --json
  runnerctl auth mappings --json
  runnerctl auth resolve OWNER/REPO --json

AI AGENT:
  Prefer mappings or --account over `auth use`; `auth use` changes global gh state.
EOF
      ;;
    "auth map")
      cat <<'EOF'
Map a repository or owner wildcard to an authenticated GitHub account.

Usage:
  runnerctl auth map OWNER/REPO ACCOUNT
  runnerctl auth map 'OWNER/*' ACCOUNT

Side effects:
  Writes ~/.config/runnerctl/accounts.tsv (or RUNNERCTL_CONFIG_HOME).

AI AGENT:
  MUTATING local configuration. Never invent account or repository names.
EOF
      ;;
    "auth resolve")
      cat <<'EOF'
Resolve which GitHub account runnerctl will use for a repository.

Usage:
  runnerctl auth resolve OWNER/REPO [--json]

Resolution order:
  1. Command-specific --account (when supported)
  2. Exact OWNER/REPO mapping
  3. OWNER/* mapping
  4. Active GitHub CLI account

Side effects:
  None (read-only).
EOF
      ;;
    logs)
      cat <<'EOF'
Show the latest GitHub Actions runner diagnostic log.

Usage:
  runnerctl logs RUNNER [--no-follow]

Flags:
  --no-follow   Print the last 200 lines and exit

AI AGENT:
  Use --no-follow so unattended automation does not block indefinitely.
EOF
      ;;
    job-logs)
      cat <<'EOF'
Show the latest GitHub Actions workflow worker diagnostic log.

Usage:
  runnerctl job-logs RUNNER [--no-follow]

Flags:
  --no-follow   Print the last 200 lines and exit

AI AGENT:
  Use --no-follow so unattended automation does not block indefinitely.
EOF
      ;;
    start|stop|restart)
      cat <<EOF
Manage one runner service.

Usage:
  runnerctl $command RUNNER

Side effects:
  MUTATING host service state. Linux may invoke sudo.

AI AGENT:
  Inspect \`runnerctl status RUNNER\` before changing service state.
EOF
      ;;
    start-all|stop-all)
      cat <<EOF
Manage every locally configured runner service.

Usage:
  runnerctl $command

Side effects:
  MUTATING host service state for multiple runners. Linux may invoke sudo.

AI AGENT:
  Inspect \`runnerctl list --json\` first because this affects all managed runners.
EOF
      ;;
    remove)
      cat <<'EOF'
Unregister a runner from GitHub and delete its local runner directory.

Usage:
  runnerctl remove RUNNER [--yes] [--account ACCOUNT]

Flags:
  --yes                Skip the interactive confirmation
  --account ACCOUNT    Override the GitHub account used for removal

Side effects:
  DESTRUCTIVE. Stops/uninstalls the service, unregisters the GitHub runner, and
  removes local runner data.

AI AGENT:
  Never use --yes unless removal of that exact runner was explicitly requested.
EOF
      ;;
    upgrade|self-update)
      cat <<'EOF'
Check for or install the latest runnerctl release.

Usage:
  runnerctl upgrade
  runnerctl upgrade --check
  runnerctl upgrade --check --json
  runnerctl self-update

Behavior:
  - Homebrew HEAD: `brew update` then `brew upgrade --fetch-HEAD runnerctl`
  - Homebrew stable: `brew update` then `brew upgrade runnerctl`
  - pnpm: installs the latest tagged GitHub release globally
  - npm: installs the latest tagged GitHub release globally
  - shell installer: downloads the latest release, verifies SHA-256, and replaces
    the installed frontend/core using install.sh

Flags:
  --check      Only check whether an update is available
  --json       Machine-readable output; requires --check
  -h, --help   Show help

Environment overrides (primarily for testing/advanced automation):
  RUNNERCTL_LATEST_VERSION
  RUNNERCTL_INSTALL_METHOD
  RUNNERCTL_INSTALL_PREFIX

Side effects:
  `--check` is read-only. Without `--check`, this command mutates the installed CLI.

AI AGENT:
  Prefer `runnerctl upgrade --check --json` before upgrading.
EOF
      ;;
    completion)
      cat <<'EOF'
Generate shell completion for runnerctl.

Usage:
  runnerctl completion bash
  runnerctl completion zsh
  runnerctl completion fish

Side effects:
  None. Output is written to stdout.
EOF
      ;;
    agent|ai-agent)
      agent_help
      ;;
    version)
      cat <<'EOF'
Print runnerctl version.

Usage:
  runnerctl version
  runnerctl --version
EOF
      ;;
    "") root_help ;;
    *) usage_error "unknown help topic: $command" ;;
  esac
}

agent_help() {
  cat <<'EOF'
AI AGENT
========
runnerctl exposes an automation contract for coding agents and CI tooling.

Recommended discovery sequence:
  1. runnerctl doctor --json
  2. runnerctl host inspect --json
  3. runnerctl auth list --json
  4. runnerctl auth mappings --json
  5. runnerctl list --json
  6. runnerctl upgrade --check --json
  7. runnerctl auth resolve OWNER/REPO --json
  8. runnerctl COMMAND --help before a mutation

Read-only / discovery:
  doctor, host inspect, host bootstrap --dry-run, list, status
  auth list, auth status, auth doctor, auth mappings, auth resolve
  upgrade --check
  logs --no-follow, job-logs --no-follow
  version, agent, completion

Mutating:
  host bootstrap
  auth use, auth login, auth setup-git, auth map, auth unmap
  add, start, stop, restart, start-all, stop-all
  upgrade, self-update

Destructive:
  remove

Agent rules:
  - Perform read-only discovery before mutation.
  - Never invent repository, account, runner, or label identifiers.
  - Prefer --account or repository mappings over changing global gh state.
  - Use `runnerctl upgrade --check --json` before upgrading when practical.
  - Use --no-follow when reading logs in unattended automation.
  - Never use `remove --yes` without explicit intent for that exact runner.
  - Never print, persist, or commit registration/removal tokens.
  - Treat self-hosted workflows as code execution on this host.
  - Do not bypass sudo or interactive privilege prompts.
  - Treat any non-zero exit code as failure.

Machine-readable contract:
  runnerctl agent --json
EOF
}

