#!/usr/bin/env bash
set -euo pipefail
VERSION="0.8.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNERCTL_REPO="${RUNNERCTL_REPO:-AdemKao/runners-self-host-management}"
find_v07(){
  local candidates=("${RUNNERCTL_BASE_V07:-}" "$SCRIPT_DIR/runnerctl-base-v07" "$SCRIPT_DIR/../libexec/runnerctl-base-v07" "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-base-v07") c
  for c in "${candidates[@]}"; do [[ -n "$c" && -f "$c" ]] || continue; printf '%s' "$c"; return; done
  printf 'runnerctl: v0.7 compatibility frontend not found. Reinstall runnerctl.\n' >&2; exit 1
}
find_monitor(){
  local candidates=("${RUNNERCTL_MONITOR_HELPER:-}" "$SCRIPT_DIR/bin/runnerctl-monitor" "$SCRIPT_DIR/runnerctl-monitor" "$SCRIPT_DIR/../libexec/runnerctl-monitor" "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-monitor") c
  for c in "${candidates[@]}"; do [[ -n "$c" && -f "$c" ]] || continue; printf '%s' "$c"; return; done
  return 1
}
v07(){ bash "$(find_v07)" "$@"; }
append_monitor_help(){ cat <<'EOF'

Authoritative job outcome monitoring:
  monitor        Poll final GitHub Actions conclusions, retain bounded history,
                 and emit exact outcome notifications.

Common commands:
  runnerctl monitor status --json
  runnerctl monitor enable --interval 60 --retention 200
  runnerctl monitor jobs --limit 20 --json
  runnerctl monitor failures --limit 20 --json

The first successful poll establishes a baseline without sending historical
notifications. Use `runnerctl monitor --help` for polling/retention semantics.
EOF
}
append_monitor_agent(){ cat <<'EOF'

Outcome monitor:
  monitor status       read-only monitor state/history counters
  monitor once         read-only GitHub polling + local history update
  monitor jobs         read-only recent outcome history
  monitor failures     read-only recent failure-like outcome history
  monitor enable       mutates local monitor config/process state
  monitor disable      mutates local monitor config/process state
  monitor run          long-running read-only GitHub poller with local writes
EOF
}
agent_json(){
  v07 agent --json | sed "s/\"version\": \"0\.7\.1\"/\"version\": \"$VERSION\"/" | awk '
    /"bot serve":/ && !added {
      print
      print "    \"monitor status\": {\"effect\": \"read-only-local\", \"json\": true},"
      print "    \"monitor once\": {\"effect\": \"read-only-github-local-history-write\", \"json\": true},"
      print "    \"monitor jobs\": {\"effect\": \"read-only-local\", \"json\": true},"
      print "    \"monitor failures\": {\"effect\": \"read-only-local\", \"json\": true},"
      print "    \"monitor enable\": {\"effect\": \"mutating-local-controller\"},"
      print "    \"monitor disable\": {\"effect\": \"mutating-local-controller\"},"
      added=1; next
    }
    { print }
  '
}
completion(){
  local shell="${1:-}"
  case "$shell" in
    bash)
      v07 completion bash | sed 's/capacity queue bot notify scheduler upgrade/capacity queue bot monitor notify scheduler upgrade/'
      cat <<'EOF'
_runnerctl_monitor_complete() {
  if [[ "${COMP_WORDS[1]:-}" == "monitor" && ${COMP_CWORD} -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "status once run enable disable jobs failures" -- "${COMP_WORDS[COMP_CWORD]}") )
  else
    _runnerctl_bot_complete "$@"
  fi
}
complete -F _runnerctl_monitor_complete runnerctl
EOF
      ;;
    zsh) v07 completion zsh | sed "s/'notify:Notification integrations and provider plugins'/'monitor:Authoritative GitHub Actions final outcome history' 'notify:Notification integrations and provider plugins'/" ;;
    fish)
      v07 completion fish | sed 's/capacity queue bot notify scheduler upgrade/capacity queue bot monitor notify scheduler upgrade/'
      printf "%s\n" "complete -c runnerctl -n '__fish_seen_subcommand_from monitor' -a 'status once run enable disable jobs failures'"
      ;;
    *) v07 completion "$@" ;;
  esac
}
normalize_version(){ local v="${1#v}"; printf '%s' "${v%%-*}"; }
version_is_newer(){
  local lhs rhs a b c x y z; lhs="$(normalize_version "$1")"; rhs="$(normalize_version "$2")"
  IFS=. read -r a b c <<<"$lhs"; IFS=. read -r x y z <<<"$rhs"; a="${a:-0}"; b="${b:-0}"; c="${c:-0}"; x="${x:-0}"; y="${y:-0}"; z="${z:-0}"
  ((10#$a > 10#$x)) && return 0; ((10#$a < 10#$x)) && return 1; ((10#$b > 10#$y)) && return 0; ((10#$b < 10#$y)) && return 1; ((10#$c > 10#$z))
}
latest_release_version(){
  if [[ -n "${RUNNERCTL_LATEST_VERSION:-}" ]]; then normalize_version "$RUNNERCTL_LATEST_VERSION"; return; fi
  command -v curl >/dev/null 2>&1 || { printf 'runnerctl: curl is required to check for updates\n' >&2; return 1; }
  local response version; response="$(curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$RUNNERCTL_REPO/releases/latest")" || return 1
  version="$(printf '%s\n' "$response" | sed -n 's/.*"tag_name":[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' | head -n1)"; [[ -n "$version" ]] || return 1; normalize_version "$version"
}
detect_install_method(){
  if [[ -n "${RUNNERCTL_INSTALL_METHOD:-}" ]]; then printf '%s' "$RUNNERCTL_INSTALL_METHOD"; return; fi
  if [[ "${RUNNERCTL_CORE:-}" == *"/Cellar/runnerctl/"* ]]; then printf homebrew; return; fi
  if command -v brew >/dev/null 2>&1 && brew list --versions runnerctl >/dev/null 2>&1; then printf homebrew; return; fi
  case "$SCRIPT_DIR" in *"/.pnpm/"*|*"/pnpm/global/"*) printf pnpm; return ;; *"/node_modules/@ademkao/runnerctl"|*"/node_modules/@ademkao/runnerctl/"*) printf npm; return ;; esac
  [[ "$(basename "$SCRIPT_DIR")" == runnerctl || "$(basename "$SCRIPT_DIR")" == libexec ]] && { printf shell; return; }; printf unknown
}
upgrade_command_for(){ case "$1" in homebrew) printf 'brew update && brew upgrade runnerctl' ;; pnpm) printf 'pnpm add -g github:%s#v%s' "$RUNNERCTL_REPO" "$2" ;; npm) printf 'npm install -g github:%s#v%s' "$RUNNERCTL_REPO" "$2" ;; shell) printf 'install GitHub Release v%s with install.sh and SHA-256 verification' "$2" ;; *) printf 'reinstall runnerctl using a supported installer' ;; esac; }
upgrade_check(){
  local json="$1" latest method available=false command; latest="$(latest_release_version)" || { printf 'runnerctl: failed to resolve latest release\n' >&2; return 1; }; method="$(detect_install_method)"; version_is_newer "$latest" "$VERSION" && available=true; command="$(upgrade_command_for "$method" "$latest")"
  if [[ "$json" -eq 1 ]]; then printf '{"current_version":"%s","latest_version":"%s","update_available":%s,"install_method":"%s","update_command":"' "$VERSION" "$latest" "$available" "$method"; printf '%s' "$command" | sed 's/\\/\\\\/g;s/"/\\"/g'; printf '"}\n'; else printf 'Current version: %s\nLatest version:  %s\nInstallation:    %s\nUpdate available: %s\n' "$VERSION" "$latest" "$method" "$([[ "$available" == true ]] && printf yes || printf no)"; [[ "$available" == false ]] || printf 'Update command:   %s\n' "$command"; fi
}
cmd_upgrade(){
  local check=0 json=0 arg latest; shift || true
  for arg in "$@"; do case "$arg" in --check) check=1 ;; --json) json=1 ;; --help|-h) v07 upgrade --help; return ;; *) printf 'runnerctl: unknown upgrade option: %s\n' "$arg" >&2; return 2 ;; esac; done
  [[ "$json" -eq 0 || "$check" -eq 1 ]] || { printf 'runnerctl: --json requires --check\n' >&2; return 2; }; [[ "$check" -eq 0 ]] || { upgrade_check "$json"; return; }
  latest="$(latest_release_version)" || return 1; if ! version_is_newer "$latest" "$VERSION"; then printf 'runnerctl %s is already up to date.\n' "$VERSION"; return; fi; RUNNERCTL_LATEST_VERSION="$latest" v07 upgrade
}
main(){
  local cmd="${1:-help}" helper
  case "$cmd" in
    version|--version|-v) printf '%s\n' "$VERSION" ;;
    monitor) shift || true; helper="$(find_monitor)" || { printf 'runnerctl: monitor helper not found. Reinstall runnerctl.\n' >&2; return 1; }; exec bash "$helper" "$@" ;;
    --help|-h) v07 "$@"; append_monitor_help ;;
    help) if [[ "${2:-}" == monitor ]]; then helper="$(find_monitor)" || return 1; exec bash "$helper" --help; fi; v07 "$@" ;;
    agent|ai-agent) if [[ "${2:-}" == --json ]]; then agent_json; else v07 "$@"; append_monitor_agent; fi ;;
    completion) shift || true; completion "$@" ;;
    upgrade|self-update) cmd_upgrade "$@" ;;
    *) exec bash "$(find_v07)" "$@" ;;
  esac
}
main "$@"