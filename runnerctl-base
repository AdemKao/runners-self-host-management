#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
RUNNERS_DIR="$RUNNERCTL_HOME/runners"
RUNNERCTL_CONFIG_HOME="${RUNNERCTL_CONFIG_HOME:-$HOME/.config/runnerctl}"
ACCOUNT_MAP_FILE="$RUNNERCTL_CONFIG_HOME/accounts.tsv"
GITHUB_HOST="${RUNNERCTL_GITHUB_HOST:-${GH_HOST:-github.com}}"
RUNNERCTL_REPO="${RUNNERCTL_REPO:-AdemKao/runners-self-host-management}"

find_core() {
  local candidates=(
    "${RUNNERCTL_CORE:-}"
    "$SCRIPT_DIR/bin/runnerctl"
    "$SCRIPT_DIR/../libexec/runnerctl-core"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-core"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: core executable not found. Reinstall runnerctl.\n' >&2
  exit 1
}

find_host_helper() {
  local candidates=(
    "${RUNNERCTL_HOST_HELPER:-}"
    "$SCRIPT_DIR/bin/runnerctl-host"
    "$SCRIPT_DIR/../libexec/runnerctl-host"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-host"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: host helper not found. Reinstall runnerctl.\n' >&2
  exit 1
}

usage_error() {
  printf 'runnerctl: %s\n' "$*" >&2
  exit 2
}

json_quote() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

json_csv_array() {
  local value="${1:-}" first=1 item
  local -a items=()
  printf '['
  IFS=',' read -r -a items <<< "$value"
  for item in "${items[@]}"; do
    [[ -n "$item" ]] || continue
    [[ $first -eq 1 ]] || printf ','
    json_quote "$item"
    first=0
  done
  printf ']'
}

meta_get() {
  local dir="$1" key="$2"
  awk -F= -v k="$key" '$1 == k {sub(/^[^=]*=/, ""); print; exit}' "$dir/.runnerctl-meta" 2>/dev/null || true
}

launchd_service_label() {
  local service="$1"
  service="${service##*/}"
  service="${service%.plist}"
  printf '%s' "$service"
}

launchd_service_running() {
  local service="$1" label domain output
  label="$(launchd_service_label "$service")"
  [[ -n "$label" ]] || return 1
  domain="gui/$(id -u)"

  if output="$(launchctl print "$domain/$label" 2>/dev/null)"; then
    if printf '%s\n' "$output" | grep -Eq '^[[:space:]]*state = running([[:space:]]|$)'; then
      return 0
    fi
    if printf '%s\n' "$output" | grep -Eq '^[[:space:]]*pid = [1-9][0-9]*([[:space:]]|$)'; then
      return 0
    fi
    return 1
  fi

  launchctl list 2>/dev/null | awk -v label="$label" '$3 == label && $1 ~ /^[0-9]+$/ { found=1 } END { exit(found ? 0 : 1) }'
}

service_state() {
  local dir="$1" service=""
  service="$(cat "$dir/.service" 2>/dev/null || true)"
  [[ -n "$service" ]] || { printf 'not-installed'; return; }
  case "$(uname -s)" in
    Darwin)
      if launchd_service_running "$service"; then printf 'running'; else printf 'stopped'; fi
      ;;
    Linux)
      if systemctl is-active --quiet "$service" 2>/dev/null; then printf 'running'; else printf 'stopped'; fi
      ;;
    *) printf 'unknown' ;;
  esac
}

active_account() {
  command -v gh >/dev/null 2>&1 || return 0
  gh auth status --active --hostname "$GITHUB_HOST" --json hosts \
    --jq ".hosts[\"$GITHUB_HOST\"][] | select(.active == true) | .login" 2>/dev/null | head -n 1 || true
}

root_help() {
  cat <<'EOF'
runnerctl - Manage GitHub Actions self-hosted runners

Usage:
  runnerctl [command]

Runner Management:
  add            Register one or more self-hosted runners
  list           List locally managed runners
  status         Show runner service status
  logs           Show runner diagnostic logs
  job-logs       Show workflow worker logs

Lifecycle:
  start          Start a runner service
  stop           Stop a runner service
  restart        Restart a runner service
  start-all      Start all managed runner services
  stop-all       Stop all managed runner services
  remove         Unregister and delete a runner

Authentication:
  auth           Manage GitHub CLI accounts and repository mappings

Maintenance:
  upgrade        Check for or install the latest runnerctl release
  self-update    Alias for upgrade
  completion     Generate shell completion

Diagnostics & Automation:
  doctor         Check the local runnerctl environment
  host           Inspect or bootstrap host prerequisites
  agent          Show the AI-agent automation contract

Other:
  help           Help about any command
  version        Print runnerctl version

Flags:
  -h, --help     Show help
  -v, --version  Print version

AI AGENT:
  Run `runnerctl agent` for automation safety guidance.
  Run `runnerctl agent --json` for a machine-readable contract.

