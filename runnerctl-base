cmd_doctor_json() {
  local os arch active gh_ok=false curl_ok=false tar_ok=false
  os="$(uname -s)"; arch="$(uname -m)"; active="$(active_account)"
  command -v gh >/dev/null 2>&1 && gh_ok=true
  command -v curl >/dev/null 2>&1 && curl_ok=true
  command -v tar >/dev/null 2>&1 && tar_ok=true
  printf '{"version":'; json_quote "$VERSION"
  printf ',"home":'; json_quote "$RUNNERCTL_HOME"
  printf ',"config_home":'; json_quote "$RUNNERCTL_CONFIG_HOME"
  printf ',"platform":{"os":'; json_quote "$os"; printf ',"arch":'; json_quote "$arch"; printf '}'
  printf ',"dependencies":{"gh":%s,"curl":%s,"tar":%s}' "$gh_ok" "$curl_ok" "$tar_ok"
  printf ',"github":{"host":'; json_quote "$GITHUB_HOST"; printf ',"active_account":'; json_quote "$active"; printf '}}\n'
}

cmd_list_json() {
  local dir name repo account labels status first=1
  mkdir -p "$RUNNERS_DIR"
  printf '{"runners":['
  shopt -s nullglob
  for dir in "$RUNNERS_DIR"/*; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    name="$(meta_get "$dir" name)"; repo="$(meta_get "$dir" repo)"
    account="$(meta_get "$dir" account)"; labels="$(meta_get "$dir" labels)"
    status="$(service_state "$dir")"
    [[ $first -eq 1 ]] || printf ','
    printf '{"name":'; json_quote "$name"
    printf ',"repository":'; json_quote "$repo"
    printf ',"account":'; json_quote "$account"
    printf ',"status":'; json_quote "$status"
    printf ',"labels":'; json_csv_array "$labels"
    printf '}'
    first=0
  done
  printf ']}\n'
}

cmd_status_json() {
  local name="${1:-}" dir repo account labels status
  [[ -n "$name" ]] || usage_error "status --json requires RUNNER"
  dir="$RUNNERS_DIR/$name"
  [[ -f "$dir/.runnerctl-meta" ]] || { printf 'runnerctl: unknown runner: %s\n' "$name" >&2; exit 1; }
  repo="$(meta_get "$dir" repo)"; account="$(meta_get "$dir" account)"
  labels="$(meta_get "$dir" labels)"; status="$(service_state "$dir")"
  printf '{"name":'; json_quote "$name"
  printf ',"repository":'; json_quote "$repo"
  printf ',"account":'; json_quote "$account"
  printf ',"status":'; json_quote "$status"
  printf ',"labels":'; json_csv_array "$labels"
  printf '}\n'
}

cmd_auth_accounts_json() {
  command -v gh >/dev/null 2>&1 || { printf '{"host":'; json_quote "$GITHUB_HOST"; printf ',"accounts":[]}\n'; return; }
  local accounts
  accounts="$(gh auth status --hostname "$GITHUB_HOST" --json hosts --jq ".hosts[\"$GITHUB_HOST\"] // [] | map({login: .login, active: (.active // false), state: (.state // \"unknown\")})" 2>/dev/null || printf '[]')"
  printf '{"host":'; json_quote "$GITHUB_HOST"; printf ',"accounts":%s}\n' "$accounts"
}

cmd_auth_mappings_json() {
  local first=1 pattern account
  printf '{"mappings":['
  if [[ -f "$ACCOUNT_MAP_FILE" ]]; then
    while IFS=$'\t' read -r pattern account; do
      [[ -n "$pattern" && -n "$account" ]] || continue
      [[ $first -eq 1 ]] || printf ','
      printf '{"pattern":'; json_quote "$pattern"; printf ',"account":'; json_quote "$account"; printf '}'
      first=0
    done < "$ACCOUNT_MAP_FILE"
  fi
  printf ']}\n'
}

cmd_auth_resolve_json() {
  local repo="${1:-}" core account
  [[ "$repo" =~ ^[^/]+/[^/]+$ ]] || usage_error "auth resolve requires OWNER/REPO"
  core="$(find_core)"
  account="$(bash "$core" auth resolve "$repo")" || exit $?
  printf '{"repository":'; json_quote "$repo"; printf ',"account":'; json_quote "$account"; printf '}\n'
}

cmd_auth_doctor_json() {
  local active protocol remote="" repo="" resolved=""
  active="$(active_account)"
  protocol="$(gh config get git_protocol --host "$GITHUB_HOST" 2>/dev/null || true)"
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    remote="$(git remote get-url origin 2>/dev/null || true)"
    case "$remote" in
      https://"$GITHUB_HOST"/*) repo="${remote#https://$GITHUB_HOST/}" ;;
      git@"$GITHUB_HOST":*) repo="${remote#git@$GITHUB_HOST:}" ;;
      ssh://git@"$GITHUB_HOST"/*) repo="${remote#ssh://git@$GITHUB_HOST/}" ;;
    esac
    repo="${repo%.git}"
    if [[ "$repo" =~ ^[^/]+/[^/]+$ ]]; then
      resolved="$(bash "$(find_core)" auth resolve "$repo" 2>/dev/null || true)"
    fi
  fi
  printf '{"host":'; json_quote "$GITHUB_HOST"
  printf ',"active_account":'; json_quote "$active"
  printf ',"git_protocol":'; json_quote "$protocol"
  printf ',"mapping_file":'; json_quote "$ACCOUNT_MAP_FILE"
  printf ',"origin":'; json_quote "$remote"
  printf ',"repository":'; json_quote "$repo"
  printf ',"resolved_account":'; json_quote "$resolved"
  printf '}\n'
}

normalize_version() {
  local version="${1#v}"
  printf '%s' "${version%%-*}"
}

version_is_newer() {
  local lhs rhs lmaj lmin lpat rmaj rmin rpat
  lhs="$(normalize_version "$1")"
  rhs="$(normalize_version "$2")"
  IFS=. read -r lmaj lmin lpat <<< "$lhs"
  IFS=. read -r rmaj rmin rpat <<< "$rhs"
  lmaj="${lmaj:-0}"; lmin="${lmin:-0}"; lpat="${lpat:-0}"
  rmaj="${rmaj:-0}"; rmin="${rmin:-0}"; rpat="${rpat:-0}"
  (( 10#$lmaj > 10#$rmaj )) && return 0
  (( 10#$lmaj < 10#$rmaj )) && return 1
  (( 10#$lmin > 10#$rmin )) && return 0
  (( 10#$lmin < 10#$rmin )) && return 1
  (( 10#$lpat > 10#$rpat ))
}

latest_release_version() {
  if [[ -n "${RUNNERCTL_LATEST_VERSION:-}" ]]; then
    normalize_version "$RUNNERCTL_LATEST_VERSION"
    return
  fi

  command -v curl >/dev/null 2>&1 || {
    printf 'runnerctl: curl is required to check for updates\n' >&2
    return 1
  }

  local response version
  response="$(curl -fsSL -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$RUNNERCTL_REPO/releases/latest")" || {
      printf 'runnerctl: failed to query the latest GitHub Release\n' >&2
      return 1
    }
  version="$(printf '%s\n' "$response" | sed -n 's/.*"tag_name":[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1)"
  [[ -n "$version" ]] || {
    printf 'runnerctl: latest GitHub Release did not contain tag_name\n' >&2
    return 1
  }
  normalize_version "$version"
}

detect_install_method() {
  if [[ -n "${RUNNERCTL_INSTALL_METHOD:-}" ]]; then
    printf '%s' "$RUNNERCTL_INSTALL_METHOD"
    return
  fi

  if [[ "${RUNNERCTL_CORE:-}" == *"/Cellar/runnerctl/"* ]]; then
    printf 'homebrew'
    return
  fi

  if command -v brew >/dev/null 2>&1 && brew list --versions runnerctl >/dev/null 2>&1; then
    printf 'homebrew'
    return
  fi

  case "$SCRIPT_DIR" in
    *"/.pnpm/"*|*"/pnpm/global/"*) printf 'pnpm'; return ;;
    *"/node_modules/@ademkao/runnerctl"|*"/node_modules/@ademkao/runnerctl/"*) printf 'npm'; return ;;
  esac

  if [[ "$(basename "$SCRIPT_DIR")" == "bin" && -f "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-core" ]]; then
    printf 'shell'
    return
  fi

  printf 'unknown'
}

infer_install_prefix() {
  if [[ -n "${RUNNERCTL_INSTALL_PREFIX:-}" ]]; then
    printf '%s' "$RUNNERCTL_INSTALL_PREFIX"
    return
  fi
  if [[ "$(basename "$SCRIPT_DIR")" == "bin" ]]; then
    (cd "$SCRIPT_DIR/.." && pwd)
    return
  fi
  printf '%s' "$HOME/.local"
}

upgrade_command_for() {
  local method="$1"
  case "$method" in
    homebrew)
      if command -v brew >/dev/null 2>&1 && brew list --versions runnerctl 2>/dev/null | grep -q 'HEAD-'; then
        printf 'brew update && brew upgrade --fetch-HEAD runnerctl'
      else
        printf 'brew update && brew upgrade runnerctl'
      fi
      ;;
    pnpm) printf 'pnpm add -g github:%s#vLATEST' "$RUNNERCTL_REPO" ;;
    npm) printf 'npm install -g github:%s#vLATEST' "$RUNNERCTL_REPO" ;;
    shell) printf 'install latest GitHub Release with install.sh and SHA-256 verification' ;;
    *) printf 'reinstall runnerctl using a supported installer' ;;
  esac
}

upgrade_status() {
  local json="${1:-0}" latest method available=false command
  latest="$(latest_release_version)"
  method="$(detect_install_method)"
  if version_is_newer "$latest" "$VERSION"; then available=true; fi
  command="$(upgrade_command_for "$method")"
  command="${command//LATEST/$latest}"

  if [[ "$json" -eq 1 ]]; then
    printf '{"current_version":'; json_quote "$VERSION"
    printf ',"latest_version":'; json_quote "$latest"
    printf ',"update_available":%s' "$available"
    printf ',"install_method":'; json_quote "$method"
    printf ',"update_command":'; json_quote "$command"
    printf '}\n'
  else
    printf 'Current version: %s\n' "$VERSION"
    printf 'Latest version:  %s\n' "$latest"
    printf 'Installation:    %s\n' "$method"
    if [[ "$available" == true ]]; then
      printf 'Update available: yes\n'
      printf 'Update command:   %s\n' "$command"
    else
      printf 'Update available: no\n'
    fi
  fi
}

perform_upgrade() {
  local latest method prefix installer
  latest="$(latest_release_version)"
  method="$(detect_install_method)"

  if ! version_is_newer "$latest" "$VERSION"; then
    printf 'runnerctl %s is already up to date.\n' "$VERSION"
    return 0
  fi

  printf 'Upgrading runnerctl %s -> %s using %s\n' "$VERSION" "$latest" "$method"

  case "$method" in
    homebrew)
      command -v brew >/dev/null 2>&1 || usage_error "Homebrew installation detected but brew is unavailable"
      brew update
      if brew list --versions runnerctl 2>/dev/null | grep -q 'HEAD-'; then
        brew upgrade --fetch-HEAD runnerctl
      else
        brew upgrade runnerctl
      fi
      ;;
    pnpm)
      command -v pnpm >/dev/null 2>&1 || usage_error "pnpm installation detected but pnpm is unavailable"
      pnpm add -g "github:$RUNNERCTL_REPO#v$latest"
      ;;
    npm)
      command -v npm >/dev/null 2>&1 || usage_error "npm installation detected but npm is unavailable"
      npm install -g "github:$RUNNERCTL_REPO#v$latest"
      ;;
    shell)
      command -v curl >/dev/null 2>&1 || usage_error "curl is required for shell self-update"
      prefix="$(infer_install_prefix)"
      installer="$(mktemp)"
      curl -fsSL "https://raw.githubusercontent.com/$RUNNERCTL_REPO/main/install.sh" -o "$installer"
      RUNNERCTL_VERSION="$latest" PREFIX="$prefix" bash "$installer"
      rm -f "$installer"
      ;;
    *)
      printf 'runnerctl: could not determine how this installation is managed.\n' >&2
      printf 'Reinstall with Homebrew, npm/pnpm, or the shell installer, then retry.\n' >&2
      return 1
      ;;
  esac

  printf 'Upgrade command completed. Run `runnerctl version` to verify the installed version.\n'
}

cmd_upgrade() {
  local check=0 json=0 arg
  shift || true
  for arg in "$@"; do
    case "$arg" in
      --check) check=1 ;;
      --json) json=1 ;;
      --help|-h) command_help upgrade; return ;;
      *) usage_error "unknown upgrade option: $arg" ;;
    esac
  done
  [[ "$json" -eq 0 || "$check" -eq 1 ]] || usage_error "--json requires --check"
  if [[ "$check" -eq 1 ]]; then
    upgrade_status "$json"
  else
    perform_upgrade
  fi
}

completion_bash() {
  cat <<'EOF'
_runnerctl_complete() {
  local cur commands auth_commands host_commands
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  commands="add list status logs job-logs start stop restart start-all stop-all remove auth doctor host upgrade self-update agent completion help version"
  auth_commands="list status use login setup-git doctor map unmap mappings resolve"
  host_commands="inspect bootstrap"
  if [[ ${COMP_CWORD} -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
  elif [[ "${COMP_WORDS[1]}" == "auth" && ${COMP_CWORD} -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "$auth_commands" -- "$cur") )
  elif [[ "${COMP_WORDS[1]}" == "host" && ${COMP_CWORD} -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "$host_commands" -- "$cur") )
  elif [[ "${COMP_WORDS[1]}" == "completion" && ${COMP_CWORD} -eq 2 ]]; then
    COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
  fi
}
complete -F _runnerctl_complete runnerctl
EOF
}

completion_zsh() {
  cat <<'EOF'
#compdef runnerctl
_runnerctl() {
  local -a commands auth_commands host_commands
  commands=(
    'add:Register self-hosted runners' 'list:List runners' 'status:Show status'
    'logs:Show runner logs' 'job-logs:Show worker logs' 'start:Start runner'
    'stop:Stop runner' 'restart:Restart runner' 'start-all:Start all runners'
    'stop-all:Stop all runners' 'remove:Remove runner' 'auth:Manage GitHub accounts'
    'doctor:Check environment' 'host:Inspect or bootstrap host prerequisites'
    'upgrade:Upgrade runnerctl' 'self-update:Upgrade runnerctl'
    'agent:AI agent contract' 'completion:Shell completion' 'help:Command help' 'version:Print version'
  )
  auth_commands=('list' 'status' 'use' 'login' 'setup-git' 'doctor' 'map' 'unmap' 'mappings' 'resolve')
  host_commands=('inspect' 'bootstrap')
  if (( CURRENT == 2 )); then
    _describe 'command' commands
  elif [[ "$words[2]" == auth && CURRENT == 3 ]]; then
    _values 'auth command' $auth_commands
  elif [[ "$words[2]" == host && CURRENT == 3 ]]; then
    _values 'host command' $host_commands
  elif [[ "$words[2]" == completion && CURRENT == 3 ]]; then
    _values 'shell' bash zsh fish
  fi
}
_runnerctl "$@"
EOF
}

completion_fish() {
  cat <<'EOF'
complete -c runnerctl -f
complete -c runnerctl -n '__fish_use_subcommand' -a 'add list status logs job-logs start stop restart start-all stop-all remove auth doctor host upgrade self-update agent completion help version'
complete -c runnerctl -n '__fish_seen_subcommand_from auth' -a 'list status use login setup-git doctor map unmap mappings resolve'
complete -c runnerctl -n '__fish_seen_subcommand_from host' -a 'inspect bootstrap'
complete -c runnerctl -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'
EOF
}

cmd_completion() {
  case "${1:-}" in
    bash) completion_bash ;;
    zsh) completion_zsh ;;
    fish) completion_fish ;;
    --help|-h|"") command_help completion ;;
    *) usage_error "unsupported shell: $1 (expected bash, zsh, or fish)" ;;
  esac
}

help_topic_from_args() {
  local first="${1:-}" second="${2:-}"
  if [[ "$first" == "auth" && -n "$second" && "$second" != --* ]]; then
    case "$second" in map|resolve) printf 'auth %s' "$second"; return ;; esac
  fi
  printf '%s' "$first"
}

main() {
  local cmd="${1:-help}" core topic sub helper
  case "$cmd" in
    --help|-h) root_help; return ;;
    --version|-v|version) printf '%s\n' "$VERSION"; return ;;
    help)
      shift || true
      if [[ $# -eq 0 ]]; then root_help; return; fi
      topic="$(help_topic_from_args "${1:-}" "${2:-}")"
      command_help "$topic"
      return
      ;;
    agent|ai-agent)
      shift || true
      case "${1:-}" in
        --json) agent_json ;;
        --help|-h|"") agent_help ;;
        *) usage_error "unknown agent option: $1" ;;
      esac
      return
      ;;
    completion)
      shift || true
      cmd_completion "$@"
      return
      ;;
    upgrade|self-update)
      cmd_upgrade "$@"
      return
      ;;
  esac

  if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
    command_help "$cmd"
    return
  fi
  if [[ "$cmd" == "auth" && ( "${3:-}" == "--help" || "${3:-}" == "-h" ) ]]; then
    topic="$(help_topic_from_args "$cmd" "${2:-}")"
    command_help "$topic"
    return
  fi

  case "$cmd" in
    doctor)
      if [[ "${2:-}" == "--json" ]]; then cmd_doctor_json; else core="$(find_core)"; bash "$core" doctor | sed -E "s/^version: .*/version: $VERSION/"; fi
      ;;
    host)
      helper="$(find_host_helper)"
      shift || true
      exec bash "$helper" "$@"
      ;;
    list)
      if [[ "${2:-}" == "--json" ]]; then cmd_list_json; else exec bash "$(find_core)" "$@"; fi
      ;;
    status)
      if [[ "${2:-}" == "--json" ]]; then cmd_status_json "${3:-}"
      elif [[ "${3:-}" == "--json" ]]; then cmd_status_json "${2:-}"
      else exec bash "$(find_core)" "$@"; fi
      ;;
    auth)
      sub="${2:-status}"
      case "$sub" in
        list|status)
          if [[ "${3:-}" == "--json" ]]; then cmd_auth_accounts_json; else exec bash "$(find_core)" "$@"; fi
          ;;
        mappings)
          if [[ "${3:-}" == "--json" ]]; then cmd_auth_mappings_json; else exec bash "$(find_core)" "$@"; fi
          ;;
        resolve)
          if [[ "${4:-}" == "--json" ]]; then cmd_auth_resolve_json "${3:-}"; else exec bash "$(find_core)" "$@"; fi
          ;;
        doctor)
          if [[ "${3:-}" == "--json" ]]; then cmd_auth_doctor_json; else exec bash "$(find_core)" "$@"; fi
          ;;
        *) exec bash "$(find_core)" "$@" ;;
      esac
      ;;
    *) exec bash "$(find_core)" "$@" ;;
  esac
}

main "$@"
