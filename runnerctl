#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
RUNNERS_DIR="$RUNNERCTL_HOME/runners"

find_base() {
  local candidates=(
    "${RUNNERCTL_BASE:-}"
    "$SCRIPT_DIR/runnerctl-base"
    "$SCRIPT_DIR/../libexec/runnerctl-base"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-base"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: frontend base not found. Reinstall runnerctl.\n' >&2
  exit 1
}

find_cleanup_helper() {
  local candidates=(
    "${RUNNERCTL_CLEANUP_HELPER:-}"
    "$SCRIPT_DIR/bin/runnerctl-cleanup"
    "$SCRIPT_DIR/../libexec/runnerctl-cleanup"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-cleanup"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: cleanup helper not found. Reinstall runnerctl.\n' >&2
  exit 1
}

append_root_cleanup_help() {
  cat <<'EOF'

Disk hygiene:
  cleanup        Manage automatic post-job workspace cleanup

Use "runnerctl cleanup --help" for cleanup commands.
EOF
}

append_add_cleanup_help() {
  cat <<'EOF'

Disk hygiene:
  --cleanup      Enable automatic workspace cleanup for newly added runners.
                 The hook runs after every job and removes GITHUB_WORKSPACE.
                 Package-manager caches are intentionally preserved.
EOF
}

run_add_with_cleanup() {
  local base helper before name dir rc=0
  local -a args=()
  base="$(find_base)"
  helper="$(find_cleanup_helper)"

  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cleanup) shift ;;
      *) args+=("$1"); shift ;;
    esac
  done

  before="$(mktemp)"
  mkdir -p "$RUNNERS_DIR"
  find "$RUNNERS_DIR" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort > "$before"

  if ! bash "$base" add "${args[@]}"; then
    rm -f "$before"
    return 1
  fi

  while IFS= read -r dir; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    if ! grep -Fxq "$dir" "$before"; then
      name="$(basename "$dir")"
      if ! bash "$helper" enable "$name"; then
        printf 'runnerctl: runner %s was added, but automatic cleanup could not be enabled.\n' "$name" >&2
        printf 'Run: runnerctl cleanup enable %q\n' "$name" >&2
        rc=1
      fi
    fi
  done < <(find "$RUNNERS_DIR" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort)

  rm -f "$before"
  return "$rc"
}

main() {
  local cmd="${1:-help}" base helper
  base="$(find_base)"

  case "$cmd" in
    cleanup)
      shift
      helper="$(find_cleanup_helper)"
      exec bash "$helper" "$@"
      ;;
    add)
      if [[ " $* " == *" --help "* || " $* " == *" -h "* ]]; then
        bash "$base" "$@"
        append_add_cleanup_help
        return
      fi
      if [[ " $* " == *" --cleanup "* ]]; then
        run_add_with_cleanup "$@"
        return
      fi
      exec bash "$base" "$@"
      ;;
    --help|-h)
      bash "$base" "$@"
      append_root_cleanup_help
      ;;
    help)
      if [[ "${2:-}" == "cleanup" ]]; then
        helper="$(find_cleanup_helper)"
        exec bash "$helper" --help
      fi
      exec bash "$base" "$@"
      ;;
    *)
      exec bash "$base" "$@"
      ;;
  esac
}

main "$@"
