#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNERCTL_HOME="${RUNNERCTL_HOME:-$HOME/.local/share/runnerctl}"
RUNNERS_DIR="$RUNNERCTL_HOME/runners"

find_base() {
  local candidates=(
    "${RUNNERCTL_BASE:-}"
    "$SCRIPT_DIR/runnerctl-base"
    "$SCRIPT_DIR/../libexec/runnerctl-base"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-base"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: frontend base not found. Reinstall runnerctl.\n' >&2
  exit 1
}

find_core() {
  local candidates=(
    "${RUNNERCTL_CORE:-}"
    "$SCRIPT_DIR/bin/runnerctl"
    "$SCRIPT_DIR/../libexec/runnerctl-core"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-core"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: core executable not found. Reinstall runnerctl.\n' >&2
  exit 1
}

find_cleanup_helper() {
  local candidates=(
    "${RUNNERCTL_CLEANUP_HELPER:-}"
    "$SCRIPT_DIR/bin/runnerctl-cleanup"
    "$SCRIPT_DIR/../libexec/runnerctl-cleanup"
    "$SCRIPT_DIR/../libexec/runnerctl/runnerctl-cleanup"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  printf 'runnerctl: cleanup helper not found. Reinstall runnerctl.\n' >&2
  exit 1
}

append_root_cleanup_help() {
  cat <<'EOF'

Disk hygiene:
  cleanup        Manage automatic post-job workspace cleanup

Use "runnerctl cleanup --help" for cleanup commands.
EOF
}

append_add_cleanup_help() {
  cat <<'EOF'

Disk hygiene:
  --cleanup      Enable automatic workspace cleanup for newly added runners.
                 The hook runs after every job and removes GITHUB_WORKSPACE.
                 Package-manager caches are intentionally preserved.
EOF
}

append_agent_cleanup_help() {
  cat <<'EOF'

Runner cleanup:
  cleanup status       read-only disk/workspace inspection
  cleanup enable       mutates local runner config and restarts the service
  cleanup enable-all   mutates all managed runner configs/services
  cleanup disable      removes runnerctl's completion hook and restarts service
  cleanup run          manually removes the selected runner workspace

For unattended automation, prefer `runnerctl cleanup status --json` first.
EOF
}

run_base() {
  local base core
  base="$(find_base)"
  core="$(find_core)"
  RUNNERCTL_CORE="$core" bash "$base" "$@"
}

exec_base() {
  local base core
  base="$(find_base)"
  core="$(find_core)"
  RUNNERCTL_CORE="$core" exec bash "$base" "$@"
}

safe_print() {
  printf '%s\n' "$1" || true
}

print_base_with_suffix() {
  local suffix="$1" output suffix_output
  shift
  output="$(run_base "$@")" || return $?
  case "$suffix" in
    root) suffix_output="$(append_root_cleanup_help)" ;;
    add) suffix_output="$(append_add_cleanup_help)" ;;
    agent) suffix_output="$(append_agent_cleanup_help)" ;;
    *) suffix_output="" ;;
  esac
  printf '%s\n%s\n' "$output" "$suffix_output" || true
}

agent_json_with_cleanup() {
  run_base agent --json | awk '
    /"status": \{"effect": "read-only", "json": true\},/ && !added {
      print
      print "    \"cleanup status\": {\"effect\": \"read-only\", \"json\": true},"
      print "    \"cleanup enable\": {\"effect\": \"mutating-local-config-and-service\"},"
      print "    \"cleanup enable-all\": {\"effect\": \"mutating-local-config-and-service-bulk\"},"
      print "    \"cleanup disable\": {\"effect\": \"mutating-local-config-and-service\"},"
      print "    \"cleanup run\": {\"effect\": \"destructive-workspace\"},"
      added=1
      next
    }
    { print }
  '
}

completion_with_cleanup() {
  local shell="${1:-}"
  case "$shell" in
    bash)
      run_base completion bash | sed 's/commands="add /commands="cleanup add /'
      ;;
    zsh)
      run_base completion zsh | awk '
        /commands=\(/ && !added { print; print "    '\''cleanup:Manage workspace cleanup'\''"; added=1; next }
        { print }
      '
      ;;
    fish)
      run_base completion fish | sed "s/-a 'add /-a 'cleanup add /"
      ;;
    *)
      run_base completion "$@"
      ;;
  esac
}

run_add_with_cleanup() {
  local helper before name dir rc=0
  local -a args=()
  helper="$(find_cleanup_helper)"

  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cleanup) shift ;;
      *) args+=("$1"); shift ;;
    esac
  done

  before="$(mktemp)"
  mkdir -p "$RUNNERS_DIR"
  find "$RUNNERS_DIR" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort > "$before"

  if ! run_base add "${args[@]}"; then
    rm -f "$before"
    return 1
  fi

  while IFS= read -r dir; do
    [[ -f "$dir/.runnerctl-meta" ]] || continue
    if ! grep -Fxq "$dir" "$before"; then
      name="$(basename "$dir")"
      if ! bash "$helper" enable "$name"; then
        printf 'runnerctl: runner %s was added, but automatic cleanup could not be enabled.\n' "$name" >&2
        printf 'Run: runnerctl cleanup enable %q\n' "$name" >&2
        rc=1
      fi
    fi
  done < <(find "$RUNNERS_DIR" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort)

  rm -f "$before"
  return "$rc"
}

main() {
  local cmd="${1:-help}" helper output

  case "$cmd" in
    cleanup)
      shift
      helper="$(find_cleanup_helper)"
      if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
        output="$(bash "$helper" "$@")" || return $?
        safe_print "$output"
        return
      fi
      exec bash "$helper" "$@"
      ;;
    add)
      if [[ " $* " == *" --help "* || " $* " == *" -h "* ]]; then
        print_base_with_suffix add "$@"
        return
      fi
      if [[ " $* " == *" --cleanup "* ]]; then
        run_add_with_cleanup "$@"
        return
      fi
      exec_base "$@"
      ;;
    --help|-h)
      print_base_with_suffix root "$@"
      ;;
    help)
      if [[ "${2:-}" == "cleanup" ]]; then
        helper="$(find_cleanup_helper)"
        output="$(bash "$helper" --help)" || return $?
        safe_print "$output"
        return
      fi
      output="$(run_base "$@")" || return $?
      safe_print "$output"
      ;;
    agent|ai-agent)
      if [[ "${2:-}" == "--json" ]]; then
        output="$(agent_json_with_cleanup)" || return $?
        safe_print "$output"
      else
        print_base_with_suffix agent "$@"
      fi
      ;;
    completion)
      if [[ $# -ge 2 ]]; then
        output="$(completion_with_cleanup "${2:-}")" || return $?
        safe_print "$output"
      else
        output="$(run_base "$@")" || return $?
        safe_print "$output"
      fi
      ;;
    *)
      exec_base "$@"
      ;;
  esac
}

main "$@"
